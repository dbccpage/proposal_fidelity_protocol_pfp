    "input_complete": {
      "title": "Input Complete",
      "type": "boolean"
    },
    "input_bytes": {
      "minimum": 0,
      "title": "Input Bytes",
      "type": "integer"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "code_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Code Sha256",
      "type": "string"
    },
    "checker_sha256": {
      "pattern": "^[0-9a-f]{64}$",
