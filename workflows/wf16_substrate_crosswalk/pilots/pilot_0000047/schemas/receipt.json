          "type": "string"
        },
        "result.json": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result.Json",
          "type": "string"
        },
        "result.yaml": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result.Yaml",
          "type": "string"
        },
        "stdout.txt": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Stdout.Txt",
          "type": "string"
        },
        "stderr.txt": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Stderr.Txt",
          "type": "string"
        },
        "diagnostic.txt": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Diagnostic.Txt",
          "type": "string"
        }
      },
      "required": [
        "input.bin",
        "result.json",
        "result.yaml",
        "stdout.txt",
        "stderr.txt",
        "diagnostic.txt"
