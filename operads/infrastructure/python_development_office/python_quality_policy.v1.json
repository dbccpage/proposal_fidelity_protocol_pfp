{
  "schema": "omega.python_quality_policy.v1",
  "version": "1.1.0",
  "receipt_directory": "artifacts/python_quality/test_execution_receipts",
  "receipt_max_age_hours": 168,
  "thresholds": {
    "physical_loc": 1000,
    "cyclomatic_complexity": 10,
    "nesting_depth": 3,
    "function_span": 50,
    "arguments": 5
  },
  "excluded_directories": [
    ".git",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
    ".tox",
    ".venv",
    "__pycache__",
    "node_modules"
  ],
  "classifications": [
    {
      "class": "vendor",
      "patterns": ["vendor/**/*.py", "**/vendor/**/*.py", "third_party/**/*.py", "**/third_party/**/*.py", "**/site-packages/**/*.py"],
      "rationale": "Externally owned vendored source is inventoried but changed only through its upstream custody process.",
      "enforce_metrics": false
    },
    {
      "class": "generated",
      "patterns": ["build/**/*.py", "**/build/**/*.py", "dist/**/*.py", "**/dist/**/*.py", "**/generated/**/*.py"],
      "rationale": "Generated Python is measured but repaired at its generator rather than by editing generated bytes.",
      "enforce_metrics": false
    },
    {
      "class": "frozen",
      "patterns": ["_ic/*.py", "_ic/**/*.py", "_ooutwire/*.py", "_ooutwire/**/*.py", "artifacts/*.py", "artifacts/**/*.py", "**/receipts/*.py", "**/receipts/**/*.py", "**/historical/*.py", "**/historical/**/*.py", "**/archive/*.py", "**/archive/**/*.py", "**/*.snapshot.py"],
      "rationale": "Evidence, receipts, historical snapshots, and archives retain source custody and are non-maintained inputs.",
      "enforce_metrics": false
    },
    {
      "class": "test",
      "patterns": ["conftest.py", "test_*.py", "tests/**/*.py", "tests_e2e/**/*.py", "**/conftest.py", "**/tests/**/*.py", "**/test_*.py"],
      "rationale": "Executable test code is maintained under test-specific architecture and complexity obligations.",
      "enforce_metrics": true
    },
    {
      "class": "maintained",
      "patterns": ["*.py", "**/*.py"],
      "rationale": "Repository-owned Python not assigned to a narrower lifecycle class is maintained production or tooling code.",
      "enforce_metrics": true
    }
  ],
  "test_tiers": [
    {"name": "unit", "execution_kind": "pytest", "patterns": ["tests/unit/*.py", "tests/unit/**/*.py", "**/tests/unit/*.py", "**/tests/unit/**/*.py", "**/tests/**/test_*unit*.py", "**/tests/python_development_office/test_*.py"]},
    {"name": "integration", "execution_kind": "pytest", "patterns": ["tests/integration/*.py", "tests/integration/**/*.py", "**/tests/integration/*.py", "**/tests/integration/**/*.py", "**/tests/**/test_*integration*.py"]},
    {"name": "e2e", "execution_kind": "pytest", "patterns": ["tests_e2e/*.py", "tests_e2e/**/*.py", "tests/e2e/*.py", "tests/e2e/**/*.py", "**/tests/e2e/*.py", "**/tests/e2e/**/*.py", "**/test_*e2e*.py"]},
    {"name": "security", "execution_kind": "pytest", "patterns": ["tests/security/*.py", "tests/security/**/*.py", "**/tests/security/*.py", "**/tests/security/**/*.py", "**/test_*security*.py", "**/test_*adversarial*.py"]},
    {"name": "mutation_style", "execution_kind": "mutation_style", "patterns": ["tests/mutation/*.py", "tests/mutation/**/*.py", "**/tests/mutation/*.py", "**/tests/mutation/**/*.py", "**/test_*mutation*.py"]},
    {"name": "mutation_engine", "execution_kind": "mutation_engine", "minimum_mutation_score": 80.0, "patterns": ["tests/mutation/*.py", "tests/mutation/**/*.py", "**/tests/mutation/*.py", "**/tests/mutation/**/*.py", "**/test_*mutation*.py"]}
  ]
}
