{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0",
  "description": "Generated from operads/skill_operad/yaml/rules_registry.yaml by python -m operads.skill_operad.skill_compiler.hook_compiler --write. Do not edit.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "run_command|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py -3.12 operads/hooks/scripts/pre_tool_git_guard.py",
            "description": "Mechanically blocks forbidden git commands and whole-suite pytest sweeps.",
            "enforces": [
              "RULE_GIT_NO_FORCE_OR_MAIN_PUSH_001",
              "RULE_GIT_EXPLICIT_STAGING_001",
              "RULE_GIT_NO_COMMIT_ALL_001",
              "RULE_PYTEST_TARGETED_RUNS_001",
              "RULE_SHELL_QUOTED_STASH_REF_001"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|Write|Edit|EditMultipleFiles|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "py -3.12 operads/hooks/scripts/post_tool_bom_linter.py",
            "description": "Enforces strict UTF-8 validation, BOM detection/stripping, and local Ruff verification.",
            "enforces": [
              "RULE_FILE_STRICT_UTF8_001",
              "RULE_PYTHON_LINTER_CLEANLINESS_001"
            ]
          }
        ]
      }
    ]
  }
}
