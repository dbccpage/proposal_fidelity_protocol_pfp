{
  "schema": "anomalon.agent-system.a00.antigravity-profile-template.v1",
  "template_only": true,
  "apply_automatically": false,
  "authority_claim": "None",
  "required_human_review": true,
  "settings": {
    "chat.tools.terminal.autoApprove": {
      "/.*/": false
    },
    "chat.tools.urls.autoApprove": {
      "/.*/": false
    },
    "terminal.integrated.enableMultiLinePasteWarning": true,
    "antigravity.agent.terminalAutoExecution": false,
    "antigravity.agent.requirePermissionApproval": true
  },
  "required_audit": {
    "disable_or_remove_auto_accept_extensions": true,
    "remove_or_isolate_legacy_installations": true,
    "attest_effective_project_skill_discovery": true,
    "attest_no_mutation_profile_is_discoverable": true,
    "attest_native_agent_approval_controls_effective": true
  },
  "mutation_roles": "refused-until-host-attestation"
}

