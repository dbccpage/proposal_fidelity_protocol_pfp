      "new": "        .filter_map(|id| id.as_text().map(str::to_owned))\n        .filter(|id| !admitted.contains_key(id))",
      "outcome": "killed"
    },
    {
      "name": "admitted ids are the overreach",
      "old": "        .filter(|id| !admitted.contains_key(id))",
      "new": "        .filter(|id| admitted.contains_key(id))",
      "outcome": "killed"
    },
    {
      "name": "nothing is overreach",
      "old": "        .filter(|id| !admitted.contains_key(id))",
      "new": "        .filter(|_| false)",
      "outcome": "killed"
    },
    {
      "name": "overreach predicate renamed",
      "old": "        \"no_admission_overreach\",",
      "new": "        \"no_overreach\",",
      "outcome": "killed"
    },
    {
      "name": "overreach always passes",
      "old": "        overreach == Datum::List(Vec::new()),",
      "new": "        true,",
      "outcome": "killed"
    },
    {
      "name": "overreach evidence dropped",
      "old": "        overreach == Datum::List(Vec::new()),\n        &overreach,",
      "new": "        overreach == Datum::List(Vec::new()),\n        &Datum::Null,",
      "outcome": "killed"
    },
    {
      "name": "admission predicate renamed",
      "old": "    checks.record(\"some_claim_admitted\", !admitted.is_empty(), &admitted_ids);",
      "new": "    checks.record(\"admitted\", !admitted.is_empty(), &admitted_ids);",
      "outcome": "killed"
    },
    {
      "name": "an empty receipt passes",
      "old": "    checks.record(\"some_claim_admitted\", !admitted.is_empty(), &admitted_ids);",
      "new": "    checks.record(\"some_claim_admitted\", true, &admitted_ids);",
      "outcome": "killed"
    },
    {
      "name": "admission evidence dropped",
      "old": "    checks.record(\"some_claim_admitted\", !admitted.is_empty(), &admitted_ids);",
      "new": "    checks.record(\"some_claim_admitted\", !admitted.is_empty(), &Datum::Null);",
      "outcome": "killed"
    },
    {
      "name": "refusal overreach key changed",
      "old": "            (\"overreach\", overreach),",
      "new": "            (\"over\", overreach),",
      "outcome": "killed"
    },
    {
      "name": "refusal admitted key changed",
      "old": "            (\"admitted\", admitted_ids),",
      "new": "            (\"ids\", admitted_ids),",
      "outcome": "killed"
    },
    {
      "name": "refusal unadmitted key changed",
      "old": "            (\"unadmitted\", names(open.clone())),\n        ]);\n        return",
      "new": "            (\"open\", names(open.clone())),\n        ]);\n        return",
      "outcome": "killed"
    },
    {
      "name": "a refusal owes nothing",
      "old": "        return Ok(checks.judge(super::CERTIFIED_CODE, detail).owing(open));",
      "new": "        return Ok(checks.judge(super::CERTIFIED_CODE, detail));",
      "outcome": "killed"
    },
    {
      "name": "scoped and full codes swapped",
      "old": "    let code = if open.is_empty() {\n        \"ALL_CLAIMS_ADMITTED\"\n    } else {\n        \"CLAIM_SCOPED\"\n    };",
      "new": "    let code = if open.is_empty() {\n        \"CLAIM_SCOPED\"\n    } else {\n        \"ALL_CLAIMS_ADMITTED\"\n    };",
      "outcome": "killed"
    },
    {
      "name": "full code changed",
      "old": "        \"ALL_CLAIMS_ADMITTED\"",
      "new": "        \"ALL_ADMITTED\"",
      "outcome": "killed"
    },
    {
      "name": "scoped code changed",
      "old": "        \"CLAIM_SCOPED\"\n    };",
      "new": "        \"SCOPED\"\n    };",
      "outcome": "killed"
    },
    {
      "name": "receipt drops the digests",
      "old": "            .map(|(id, bound)| (id, Datum::Text(bound)))",
      "new": "            .map(|(id, _bound)| (id, Datum::Text(String::new())))",
      "outcome": "killed"
    },
    {
      "name": "receipt admitted key changed",
      "old": "    let detail = Datum::map([(\"admitted\", receipt), (\"unadmitted\", names(open.clone()))]);",
      "new": "    let detail = Datum::map([(\"receipt\", receipt), (\"unadmitted\", names(open.clone()))]);",
      "outcome": "killed"
    },
    {
      "name": "receipt unadmitted key changed",
      "old": "    let detail = Datum::map([(\"admitted\", receipt), (\"unadmitted\", names(open.clone()))]);",
      "new": "    let detail = Datum::map([(\"admitted\", receipt), (\"open\", names(open.clone()))]);",
      "outcome": "killed"
    },
    {
      "name": "a certified receipt owes nothing",
      "old": "    Ok(certified(code, detail).owing(open))",
      "new": "    Ok(certified(code, detail))",
      "outcome": "killed"
    }
  ]
