<Application x:Class="PfpLab.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <!-- AuthorityEffect: None. -->
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#2F5BD3" />
    <SolidColorBrush x:Key="Ok" Color="#1D7A46" />
    <SolidColorBrush x:Key="Refused" Color="#B3261E" />
    <SolidColorBrush x:Key="Line" Color="#DFE1E5" />
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
  </Application.Resources>
</Application>
