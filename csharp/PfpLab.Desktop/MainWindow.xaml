<Window x:Class="PfpLab.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PFP Lab" Width="1200" Height="780" MinWidth="820" MinHeight="520">
  <!-- AuthorityEffect: None. Layout only; all behaviour is in MainViewModel. -->
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="PFP Lab" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
      <TextBlock Text="Pack" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox x:Name="PackBox" Width="280" ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedPack}"
                DisplayMemberPath="PackId" SelectionChanged="OnPackChanged" AutomationProperties.Name="Built-in pack" />
      <Button Content="Run" Command="{Binding RunCommand}" Margin="8,0,0,0" Padding="14,4"
              Background="{StaticResource Accent}" Foreground="White" />
      <Button Content="Save receipt..." Click="OnSave" Margin="8,0,0,0" Padding="10,4" />
      <Button Content="Verify a receipt..." Click="OnVerify" Margin="8,0,0,0" Padding="10,4" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
      <TextBlock x:Name="StatusLine" Text="{Binding Status}" TextWrapping="Wrap" />
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="280" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="3*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Scenario (rationals are strings: &quot;3&quot;, &quot;-2&quot;, &quot;3/2&quot;)"
                   Margin="0,0,0,4" />
        <TextBox Text="{Binding ScenarioJson, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                 FontFamily="{StaticResource Mono}" FontSize="12" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Scenario JSON" />
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />

      <DockPanel Grid.Column="2">
        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,8">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Final defect D(s)" Foreground="Gray" />
            <TextBlock Text="{Binding Defect}" FontFamily="{StaticResource Mono}" FontSize="20" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Obstruction Φ₁" Foreground="Gray" />
            <TextBlock Text="{Binding Obstruction}" FontFamily="{StaticResource Mono}" FontSize="20" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Admitted" Foreground="Gray" />
            <TextBlock Text="{Binding Admitted}" FontFamily="{StaticResource Mono}" FontSize="20" FontWeight="SemiBold" />
          </StackPanel>
        </UniformGrid>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Digest}" FontFamily="{StaticResource Mono}" FontSize="11"
                   Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0" />
        <DataGrid ItemsSource="{Binding Verdicts}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" AutomationProperties.Name="Verdicts">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Step" Binding="{Binding StepId}" />
            <DataGridTextColumn Header="Move" Binding="{Binding Move}" />
            <DataGridCheckBoxColumn Header="Admitted" Binding="{Binding Admitted}" />
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
            <DataGridTextColumn Header="Before" Binding="{Binding DefectBefore}" />
            <DataGridTextColumn Header="After" Binding="{Binding DefectAfter}" />
            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
