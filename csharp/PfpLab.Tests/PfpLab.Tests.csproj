<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AuthorityEffect: None.
    Unit and contract tests, run as a console program (dotnet run). The machine's
    NuGet source mapping does not admit a test-runner package, so this project
    carries its own small runner and needs no packages. Exit code 0 means every
    test passed; 3 means at least one failed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <RootNamespace>PfpLab.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PfpLab.Client\PfpLab.Client.csproj" />
    <ProjectReference Include="..\PfpLab.Desktop\PfpLab.Desktop.csproj" />
  </ItemGroup>
</Project>
