import Derivation.PresentationRelativity

/-!
# Closure failure is loss of invariance under an internal symmetry

An attempted closure has two internal faces, `p` and `q`, on one
represented domain `D`.  No evaluator, external observer, or authority
is primitive.

If `p` identifies two represented points while `q` separates them,
their transposition is an internal symmetry of the `p` face: `p` is
invariant under it.  The `q` face is not invariant under that same
symmetry.  Conversely, any represented involutive symmetry preserving
`p` but not `q` supplies exactly such a residual pair.

Therefore these three statements are equivalent:

1. the attempted correspondence `p → q` does not factor;
2. a directional residual exists;
3. `q` ceases to be invariant under an internal symmetry of `p`.

The symmetry is constructed from the failed fiber itself.  Nothing
selects a repair, promotes one face over the other, or surveys the
attempt from nowhere.
-/

namespace ClosureSymmetry

open Compression PresentationRelativity

/-- The transposition generated by a represented pair. -/
def transpose (a b x : Nat) : Nat :=
  if x = a then b else if x = b then a else x

theorem transpose_left (a b : Nat) :
    transpose a b a = b := by
  simp [transpose]

theorem transpose_right (a b : Nat) :
    transpose a b b = a := by
  by_cases h : a = b
  · subst b
    simp [transpose]
  · simp [transpose, Ne.symm h]

theorem transpose_fixed {a b x : Nat} (ha : x ≠ a) (hb : x ≠ b) :
    transpose a b x = x := by
  simp [transpose, ha, hb]

theorem transpose_involutive (a b : Nat) :
    ∀ x, transpose a b (transpose a b x) = x := by
  intro x
  by_cases hab : a = b
  · subst b
    by_cases hxa : x = a
    · subst x
      simp [transpose]
    · simp [transpose, hxa]
  · by_cases hxa : x = a
    · subst x
      rw [transpose_left, transpose_right]
    · by_cases hxb : x = b
      · subst x
        rw [transpose_right, transpose_left]
      · have hfixed := transpose_fixed hxa hxb
        rw [hfixed, hfixed]

/-- A symmetry internal to one attempted `p → q` closure.  The map is
an involution preserving the represented domain and the `p` face.  A
single represented point witnesses that the `q` face is not invariant
under the same map. -/
structure InternalSymmetryBreak
    (D : List Nat) (p q : Nat → Nat) where
  symmetry : Nat → Nat
  involutive : ∀ x, symmetry (symmetry x) = x
  domain_preserved : ∀ x, x ∈ D → symmetry x ∈ D
  p_invariant : ∀ x, x ∈ D → p (symmetry x) = p x
  point : Nat
  point_mem : point ∈ D
  q_not_invariant : q (symmetry point) ≠ q point

/-- Every directional residual generates its own transposition
symmetry.  The `p` face is invariant; the `q` face is not. -/
def residual_to_internal_symmetry_break
    {D : List Nat} {p q : Nat → Nat}
    (r : DirectionalResidual D p q) :
    InternalSymmetryBreak D p q := by
  refine
    { symmetry := transpose r.left r.right
      involutive := transpose_involutive r.left r.right
      domain_preserved := ?_
      p_invariant := ?_
      point := r.left
      point_mem := r.left_mem
      q_not_invariant := ?_ }
  · intro x hx
    by_cases hxl : x = r.left
    · rw [hxl, transpose_left]
      exact r.right_mem
    · by_cases hxr : x = r.right
      · rw [hxr, transpose_right]
        exact r.left_mem
      · rw [transpose_fixed hxl hxr]
        exact hx
  · intro x _
    by_cases hxl : x = r.left
    · rw [hxl, transpose_left]
      exact r.identified.symm
    · by_cases hxr : x = r.right
      · rw [hxr, transpose_right]
        exact r.identified
      · rw [transpose_fixed hxl hxr]
  · rw [transpose_left]
    exact r.separated.symm

/-- Conversely, loss of `q`-invariance under an internal `p` symmetry
is exactly a represented directional residual. -/
def internal_symmetry_break_to_residual
    {D : List Nat} {p q : Nat → Nat}
    (b : InternalSymmetryBreak D p q) :
    DirectionalResidual D p q := by
  refine ⟨b.point, b.symmetry b.point, b.point_mem,
    b.domain_preserved b.point b.point_mem, ?_, ?_⟩
  · exact (b.p_invariant b.point b.point_mem).symm
  · exact b.q_not_invariant.symm

/-- The residual form and the internal-symmetry-break form contain the
same represented obstruction data. -/
theorem residual_nonempty_iff_internal_symmetry_break_nonempty
    (D : List Nat) (p q : Nat → Nat) :
    Nonempty (DirectionalResidual D p q) ↔
      Nonempty (InternalSymmetryBreak D p q) := by
  constructor
  · rintro ⟨r⟩
    exact ⟨residual_to_internal_symmetry_break r⟩
  · rintro ⟨b⟩
    exact ⟨internal_symmetry_break_to_residual b⟩

/-- A residual directly refutes closure of the attempted
correspondence `p → q`. -/
theorem residual_refutes_factorization
    {D : List Nat} {p q : Nat → Nat}
    (r : DirectionalResidual D p q) :
    ¬ FactorsOn D p q := by
  intro hfactor
  have hfc := (factors_iff_fiberConstant D p q).mp hfactor
  exact r.separated
    (hfc r.left r.left_mem r.right r.right_mem r.identified)

/-- **Closure failure, residual, and loss of symmetry invariance are
one statement.**  The forward direction extracts the represented
failed fiber and constructs its transposition.  The reverse direction
uses the point at which `q` ceases to be invariant. -/
theorem closure_failure_iff_internal_symmetry_break
    (D : List Nat) (p q : Nat → Nat) :
    (¬ FactorsOn D p q) ↔
      Nonempty (InternalSymmetryBreak D p q) := by
  constructor
  · intro hfail
    obtain ⟨r⟩ := directionalResidual_of_factorization_failure D p q hfail
    exact ⟨residual_to_internal_symmetry_break r⟩
  · rintro ⟨b⟩
    exact residual_refutes_factorization
      (internal_symmetry_break_to_residual b)

end ClosureSymmetry
