import Derivation.ClosureSymmetry

/-!
# A current residual closes by losing its generating symmetry

The maps `p` and `q` are internal faces of one attempted closure on a
represented domain `D`.  A failure of `q` to factor through `p` is not
an evaluator's verdict: it is the exact pair on which `p` remains
invariant under a generated transposition while `q` does not.

Suppose a further presentation `r` carries both faces.  Then `r` must
separate that pair.  Consequently `r` is not invariant under the
symmetry that generated the current residual, its represented class
count is strictly larger than that of `p`, and the `r -> q`
correspondence factors.  Thus no residual or internal symmetry break
of that same directional closure remains.

This is a theorem about the current represented obstruction.  It does
not generate `r`, forbid a later residual under another comparison, or
introduce an observer, evaluator, truth object, authority, or preferred
repair.
-/

namespace ResidualClosure

open Compression PresentationRelativity ClosureSymmetry

/-- Invariance of a represented face under a supplied internal map. -/
def InvariantUnderOn
    (D : List Nat) (f sigma : Nat -> Nat) : Prop :=
  forall x, x ∈ D -> f (sigma x) = f x

/-- A face that factors through another face inherits every represented
symmetry of that finer face. -/
theorem factorization_preserves_invariance
    {D : List Nat} {r q sigma : Nat -> Nat}
    (hrq : FactorsOn D r q)
    (hsigma : forall x, x ∈ D -> sigma x ∈ D)
    (hr : InvariantUnderOn D r sigma) :
    InvariantUnderOn D q sigma := by
  intro x hx
  have hfc := (factors_iff_fiberConstant D r q).mp hrq
  exact hfc (sigma x) (hsigma x hx) x hx (hr x hx)

/-- Any presentation carrying the separated face must cease to be
invariant under the symmetry generated by the current residual. -/
theorem carrying_right_face_loses_generating_invariance
    {D : List Nat} {p q r : Nat -> Nat}
    (b : InternalSymmetryBreak D p q)
    (hrq : FactorsOn D r q) :
    Not (InvariantUnderOn D r b.symmetry) := by
  intro hr
  have hq := factorization_preserves_invariance hrq b.domain_preserved hr
  exact b.q_not_invariant (hq b.point b.point_mem)

/-- The loss of invariance is witnessed at the same represented point
that witnessed the original closure failure. -/
theorem carrying_right_face_splits_generating_pair
    {D : List Nat} {p q r : Nat -> Nat}
    (b : InternalSymmetryBreak D p q)
    (hrq : FactorsOn D r q) :
    r (b.symmetry b.point) ≠ r b.point := by
  intro hr
  have hfc := (factors_iff_fiberConstant D r q).mp hrq
  exact b.q_not_invariant
    (hfc (b.symmetry b.point)
      (b.domain_preserved b.point b.point_mem)
      b.point b.point_mem hr)

/-- Carrying both internal faces strictly increases represented class
count over the face whose symmetry generated the residual. -/
theorem common_refinement_strictly_splits_left_face
    {D : List Nat} {p q r : Nat -> Nat}
    (b : InternalSymmetryBreak D p q)
    (hrp : FactorsOn D r p)
    (hrq : FactorsOn D r q) :
    classCount D [p] < classCount D [r] := by
  apply classCount_lt_of_refinement_split D p r hrp
    (b.symmetry b.point) b.point
    (b.domain_preserved b.point b.point_mem) b.point_mem
    (b.p_invariant b.point b.point_mem)
  exact carrying_right_face_splits_generating_pair b hrq

/-- Once `q` factors through `r`, the current directional residual from
`r` to `q` is empty. -/
theorem current_directional_residual_is_empty
    {D : List Nat} {r q : Nat -> Nat}
    (hrq : FactorsOn D r q) :
    Not (Nonempty (DirectionalResidual D r q)) := by
  rintro ⟨residual⟩
  exact residual_refutes_factorization residual hrq

/-- Equivalently, no internal symmetry of `r` can witness failure of
the already-factored `r -> q` correspondence. -/
theorem current_internal_symmetry_break_is_empty
    {D : List Nat} {r q : Nat -> Nat}
    (hrq : FactorsOn D r q) :
    Not (Nonempty (InternalSymmetryBreak D r q)) := by
  intro hbreak
  exact (closure_failure_iff_internal_symmetry_break D r q).mpr hbreak hrq

/-- The exact closure law for the current obstruction.  A common
refinement loses the generating invariance, splits its witness, grows
strictly over `p`, and closes the directional `r -> q` correspondence.
No statement is made about residuals generated by later comparisons. -/
theorem common_refinement_closes_current_obstruction
    {D : List Nat} {p q r : Nat -> Nat}
    (b : InternalSymmetryBreak D p q)
    (hrp : FactorsOn D r p)
    (hrq : FactorsOn D r q) :
    Not (InvariantUnderOn D r b.symmetry) ∧
      r (b.symmetry b.point) ≠ r b.point ∧
        classCount D [p] < classCount D [r] ∧
          Not (Nonempty (DirectionalResidual D r q)) ∧
            Not (Nonempty (InternalSymmetryBreak D r q)) := by
  exact ⟨carrying_right_face_loses_generating_invariance b hrq,
    carrying_right_face_splits_generating_pair b hrq,
    common_refinement_strictly_splits_left_face b hrp hrq,
    current_directional_residual_is_empty hrq,
    current_internal_symmetry_break_is_empty hrq⟩

end ResidualClosure
