import Derivation.TransitionAlphabet

/-!
# The trace algebra of the passage dynamics

Typed transition records, legal traces, and the laws that the
transition monoid of `Derivation.PrimitivePassage` actually satisfies
— each proved, or replaced by the smallest countermodel that refutes
it.

What is derived here, in order:

1. **Typed records and legal traces.**  A record binds pre-state,
   event, discharged guard, post-state, effect class and resource
   delta; a trace is legal when consecutive records are chained and
   every record is well-formed.  Erasing a legal trace to its event
   list and replaying gives back the trace's own end state
   (`replay_erases`).
2. **The normal form of a step** (`step_eq_ite`): every event is
   either inert or applies its named post-state constructor, and the
   dividing line is exactly `guardHolds`.  Every law below is read off
   this decomposition rather than from the raw `step` match.
3. **Identity laws.**  A halted state is inert for everything
   (imported); `guardHolds` is the exact inertness criterion; and
   **every event is idempotent at every state** (`step_idem`) — the
   transition monoid is generated by idempotents.  That is stronger
   than the expected "dedup-guarded events are idempotent", and it
   holds for the two funded events as well, for a different reason
   (the refined column leaves the menu, the created column is already
   present).
4. **Commutation.**  Disjoint support is *not* sufficient: guards read
   fields that their own step never writes.  Three sufficient FRAME
   families are proved — for license writes, budget writes, and
   occurrence supply — using declared insensitivity predicates.  They
   are not proved necessary or exhaustive. Five
   countermodels record what fails: license against extension, budget
   against extension, the terminal against any write, occurrence
   supply against retention, and two writes into the SAME list store
   (which do not commute, because the store is a list: presentation
   order is retained, and observational agreement of the two results
   is proved separately, never conflated with equality).
5. **What internal traces cannot do**: no trace of non-environment
   events changes the occurrence store or the license
   (`internal_trace_preserves_occ`, `internal_trace_preserves_license`)
   and the internal generator emits neither constructor — but it DOES
   emit the unit budget write, so the same statement for budget is
   false and is not made.
6. **Refusal is not erasable syntax**: it changes the state, and the
   refusal store is append-only under every event and every trace.
7. **Replay equivalence is scoped**: unscoped equivalence has a
   countermodel, so the relation is always relative to a declared
   start-state predicate.
8. **A rewrite system on event lists** with two rules (adjacent
   idempotence, post-terminal absorption), proved sound for EVERY
   start state, terminating by length, and confluent with a computed
   unique normal form.  It is deliberately much weaker than replay
   equivalence, and the gap is exhibited: `rewrite_not_complete`
   gives two event lists that replay identically from every state and
   are not identified by the system. This refutes completeness of this
   particular two-rule normalizer; it does not prove that no complete
   canonicalizer for universal or start-scoped replay equivalence can
   exist.
-/

namespace TraceAlgebra

open PrimitivePassage TransitionAlphabet

private theorem hfalse : ¬ (false = true) := fun hc => Bool.noConfusion hc

/-! ## 1. The named post-state of an event, and the step normal form -/

/-- The post-state an event installs when its guard is discharged.
On a pre-observational state the two observation-changing events have
no post-state, and the definition returns the pre-state; the guard
excludes that case (`refineOk_declared`, `colOk_declared`). -/
def postOf (s : PState) : PEvent → PState
  | .admitOcc t => occS s t
  | .assertWit i j => assS s i j
  | .admitWit i j => witS s i j
  | .protect i j => protS s i j
  | .declareObs => obsS s
  | .refineCol v p =>
      match s.obs with
      | none => s
      | some cols => refineS s cols v p
  | .addCol c =>
      match s.obs with
      | none => s
      | some cols => colS s cols c
  | .refuse i j => refuseS s i j
  | .setBudget n => budS s n
  | .setLicense b => licS s b
  | .halt => haltS s

theorem live_of_accepted (s : PState) (e : PEvent)
    (h : Accepted s e = true) : s.halted = false := by
  cases hh : s.halted with
  | false => rfl
  | true => rw [halted_accepts_nothing s hh e] at h; exact absurd h hfalse

theorem live_of_guardHolds (s : PState) (e : PEvent)
    (h : guardHolds s e = true) : s.halted = false :=
  live_of_accepted s e (by rw [accepted_eq_guardHolds]; exact h)

/-- **The step normal form.**  Every event either is inert or installs
its named post-state, and `guardHolds` decides which. -/
theorem step_eq_ite (s : PState) (e : PEvent) :
    step s e = if guardHolds s e = true then postOf s e else s := by
  cases hgd : guardHolds s e with
  | false =>
      rw [if_neg hfalse]
      exact (accepted_false_iff s e).mp
        (by rw [accepted_eq_guardHolds]; exact hgd)
  | true =>
      rw [if_pos rfl]
      have hlive : s.halted = false := live_of_guardHolds s e hgd
      cases e with
      | admitOcc t =>
          simp only [guardHolds, hlive, Bool.not_false, Bool.true_and,
            Bool.not_eq_true', decide_eq_false_iff_not] at hgd
          rw [step_admitOcc_acc s t hlive hgd]
          rfl
      | assertWit i j =>
          simp only [guardHolds, hlive, Bool.not_false, Bool.true_and] at hgd
          rw [step_assertWit_acc s i j hlive hgd]
          rfl
      | admitWit i j =>
          simp only [guardHolds, hlive, Bool.not_false, Bool.true_and] at hgd
          rw [step_admitWit_acc s i j hlive hgd]
          rfl
      | protect i j =>
          simp only [guardHolds, hlive, Bool.not_false, Bool.true_and] at hgd
          rw [step_protect_acc s i j hlive hgd]
          rfl
      | declareObs =>
          simp only [guardHolds, hlive, Bool.not_false, Bool.true_and,
            decide_eq_true_eq] at hgd
          rw [step_declareObs_acc s hlive hgd]
          rfl
      | refineCol v p =>
          simp only [guardHolds, hlive, Bool.not_false, Bool.true_and] at hgd
          have hok : refineOk s v p = true := by
            simp only [Bool.and_eq_true] at hgd; exact hgd.1
          have hb : 0 < s.budget := by
            simp only [Bool.and_eq_true, decide_eq_true_eq] at hgd
            exact hgd.2
          obtain ⟨cols, ho⟩ := refineOk_declared s v p hok
          rw [step_refineCol_acc s cols v p hlive ho hok hb]
          simp only [postOf, ho]
      | addCol c =>
          simp only [guardHolds, hlive, Bool.not_false, Bool.true_and] at hgd
          have hok : colOk s c = true := by
            simp only [Bool.and_eq_true] at hgd; exact hgd.1.1
          have hl : s.licensed = true := by
            simp only [Bool.and_eq_true] at hgd; exact hgd.1.2
          have hb : 0 < s.budget := by
            simp only [Bool.and_eq_true, decide_eq_true_eq] at hgd
            exact hgd.2
          obtain ⟨cols, ho⟩ := colOk_declared s c hok
          rw [step_addCol_acc s cols c hlive ho hok hl hb]
          simp only [postOf, ho]
      | refuse i j =>
          simp only [guardHolds, hlive, Bool.not_false, Bool.true_and] at hgd
          rw [step_refuse_acc s i j hlive hgd]
          rfl
      | setBudget n =>
          rw [step_setBudget_live s n hlive]
          rfl
      | setLicense b =>
          rw [step_setLicense_live s b hlive]
          rfl
      | halt =>
          rw [step_halt_eq s]
          rfl

/-! ## 2. Identity and inertness laws -/

/-- The exact inertness criterion, restated on this side: an event is
inert at `s` precisely when its guard fails there. -/
theorem inert_iff_guard_fails (s : PState) (e : PEvent) :
    step s e = s ↔ guardHolds s e = false := by
  constructor
  · intro h
    rw [← accepted_eq_guardHolds]
    exact (accepted_false_iff s e).mpr h
  · intro h
    rw [step_eq_ite, h, if_neg hfalse]

/-- Imported from the passage: the terminal absorbs. -/
theorem terminal_absorbs (s : PState) (e : PEvent) :
    step (step s .halt) e = step s .halt := terminal_absorbing s e

theorem replayP_halted (l : List PEvent) (s : PState) (h : s.halted = true) :
    replayP l s = s := by
  induction l generalizing s with
  | nil => rfl
  | cons e rest ih =>
      show replayP rest (step s e) = s
      rw [step_halted s e h]
      exact ih s h

/-- Post-terminal absorption for whole traces. -/
theorem trace_absorbs (l : List PEvent) (s : PState) :
    replayP (.halt :: l) s = step s .halt := by
  show replayP l (step s .halt) = step s .halt
  exact replayP_halted l _ rfl

/-! ### Idempotence

Not only the dedup-guarded events: EVERY event of the alphabet is
idempotent at EVERY state.  The two funded events are idempotent for
their own reasons — the refined column is no longer in the declared
menu, and the created column is already present — and both are proved
below. -/

theorem mem_append_singleton {α : Type} (l : List α) (a : α) :
    a ∈ l ++ [a] := by
  induction l with
  | nil => exact List.Mem.head []
  | cons b t ih => exact List.Mem.tail b ih

theorem v_not_mem_map (cols : List (List Nat)) (v : List Nat) (p : Nat) :
    v ∉ cols.map (fun c => if c = v then p :: c else c) := by
  intro hmem
  obtain ⟨c, _, he⟩ := List.mem_map.mp hmem
  by_cases hc : c = v
  · subst hc
    rw [if_pos rfl] at he
    have hl := congrArg List.length he
    simp only [List.length_cons] at hl
    omega
  · rw [if_neg hc] at he
    exact hc he

theorem colOk_false_of_mem (t : PState) (cols : List (List Nat))
    (c : List Nat) (ho : t.obs = some cols) (hc : c ∈ cols) :
    colOk t c = false := by
  unfold colOk
  rw [ho]
  simp only [decide_eq_true hc, Bool.not_true, Bool.and_false,
    Bool.false_and]

theorem refineOk_false_of_not_mem (t : PState) (cols : List (List Nat))
    (v : List Nat) (p : Nat) (ho : t.obs = some cols) (hv : v ∉ cols) :
    refineOk t v p = false := by
  unfold refineOk
  rw [ho]
  simp only [decide_eq_false hv, Bool.false_and]

theorem guardHolds_post_false (s : PState) (e : PEvent)
    (hacc : Accepted s e = true) : guardHolds (step s e) e = false := by
  have hlive : s.halted = false := live_of_accepted s e hacc
  have hgd : guardHolds s e = true := by
    rw [← accepted_eq_guardHolds]; exact hacc
  cases e with
  | admitOcc t =>
      simp only [guardHolds, hlive, Bool.not_false, Bool.true_and,
        Bool.not_eq_true', decide_eq_false_iff_not] at hgd
      rw [step_admitOcc_acc s t hlive hgd]
      have hmem : (decide (t ∈ (occS s t).occ)) = true :=
        decide_eq_true (mem_append_singleton s.occ t)
      simp only [guardHolds, hmem, Bool.not_true, Bool.and_false]
  | assertWit i j =>
      simp only [guardHolds, hlive, Bool.not_false, Bool.true_and] at hgd
      rw [step_assertWit_acc s i j hlive hgd]
      have hmem : (decide ((i, j) ∈ (assS s i j).asserted)) = true :=
        decide_eq_true (mem_append_singleton s.asserted (i, j))
      simp only [guardHolds, hmem, Bool.not_true, Bool.and_false]
  | admitWit i j =>
      simp only [guardHolds, hlive, Bool.not_false, Bool.true_and] at hgd
      rw [step_admitWit_acc s i j hlive hgd]
      have hmem : (decide ((i, j) ∈ (witS s i j).wit)) = true :=
        decide_eq_true (mem_append_singleton s.wit (i, j))
      simp only [guardHolds, hmem, Bool.not_true, Bool.and_false]
  | protect i j =>
      simp only [guardHolds, hlive, Bool.not_false, Bool.true_and] at hgd
      rw [step_protect_acc s i j hlive hgd]
      have hmem : (decide ((i, j) ∈ (protS s i j).prot)) = true :=
        decide_eq_true (mem_append_singleton s.prot (i, j))
      simp only [guardHolds, hmem, Bool.not_true, Bool.and_false]
  | declareObs =>
      simp only [guardHolds, hlive, Bool.not_false, Bool.true_and,
        decide_eq_true_eq] at hgd
      rw [step_declareObs_acc s hlive hgd]
      have h2 : (decide ((obsS s).obs = none)) = false := rfl
      simp only [guardHolds, h2, Bool.and_false]
  | refineCol v p =>
      simp only [guardHolds, hlive, Bool.not_false, Bool.true_and] at hgd
      have hok : refineOk s v p = true := by
        simp only [Bool.and_eq_true] at hgd; exact hgd.1
      have hb : 0 < s.budget := by
        simp only [Bool.and_eq_true, decide_eq_true_eq] at hgd; exact hgd.2
      obtain ⟨cols, ho⟩ := refineOk_declared s v p hok
      rw [step_refineCol_acc s cols v p hlive ho hok hb]
      have h2 : refineOk (refineS s cols v p) v p = false :=
        refineOk_false_of_not_mem (refineS s cols v p)
          (cols.map (fun c => if c = v then p :: c else c)) v p rfl
          (v_not_mem_map cols v p)
      simp only [guardHolds, h2, Bool.and_false, Bool.false_and]
  | addCol c =>
      simp only [guardHolds, hlive, Bool.not_false, Bool.true_and] at hgd
      have hok : colOk s c = true := by
        simp only [Bool.and_eq_true] at hgd; exact hgd.1.1
      have hl : s.licensed = true := by
        simp only [Bool.and_eq_true] at hgd; exact hgd.1.2
      have hb : 0 < s.budget := by
        simp only [Bool.and_eq_true, decide_eq_true_eq] at hgd; exact hgd.2
      obtain ⟨cols, ho⟩ := colOk_declared s c hok
      rw [step_addCol_acc s cols c hlive ho hok hl hb]
      have h2 : colOk (colS s cols c) c = false :=
        colOk_false_of_mem (colS s cols c) (cols ++ [c]) c rfl
          (mem_append_singleton cols c)
      simp only [guardHolds, h2, Bool.and_false, Bool.false_and]
  | refuse i j =>
      simp only [guardHolds, hlive, Bool.not_false, Bool.true_and] at hgd
      rw [step_refuse_acc s i j hlive hgd]
      have hmem : (decide ((i, j) ∈ (refuseS s i j).refusals)) = true :=
        decide_eq_true (mem_append_singleton s.refusals (i, j))
      simp only [guardHolds, hmem, Bool.not_true, Bool.and_false]
  | setBudget n =>
      rw [step_setBudget_live s n hlive]
      have hmem : (decide (n = (budS s n).budget)) = true :=
        decide_eq_true rfl
      simp only [guardHolds, hmem, Bool.not_true, Bool.and_false]
  | setLicense b =>
      rw [step_setLicense_live s b hlive]
      have hmem : (decide (b = (licS s b).licensed)) = true :=
        decide_eq_true rfl
      simp only [guardHolds, hmem, Bool.not_true, Bool.and_false]
  | halt =>
      rw [step_halt_eq s]
      rfl

/-- **Every event is idempotent at every state.** -/
theorem step_idem (s : PState) (e : PEvent) :
    step (step s e) e = step s e := by
  cases hacc : Accepted s e with
  | false => simp only [(accepted_false_iff s e).mp hacc]
  | true =>
      exact (inert_iff_guard_fails (step s e) e).mpr
        (guardHolds_post_false s e hacc)

/-- Dedup-guarded idempotence, stated on the state the guard is about,
so that the mechanism is visible and not only the conclusion. -/
theorem retention_idem (s : PState) (i j : Nat) :
    step (step s (.admitWit i j)) (.admitWit i j) = step s (.admitWit i j) :=
  step_idem s _

theorem terminal_idem (s : PState) :
    step (step s .halt) .halt = step s .halt := step_idem s _

/-! ## 3. Typed transition records and legal traces -/

structure TRecord where
  pre : PState
  ev : PEvent
  guard : GuardKind
  post : PState
  cls : EffectClass
  spend : BudgetDelta
  profile : Profile
deriving Repr, DecidableEq

/-- A record is well-formed when every component is
the one the dynamics computes: no field of a record is free data. -/
def WFRecord (r : TRecord) : Prop :=
  r.post = step r.pre r.ev ∧ r.guard = guardOf r.ev ∧
  r.cls = classOf r.pre r.ev ∧ r.spend = budgetDeltaOf r.pre r.post ∧
  r.profile = profileOf r.pre r.ev ∧ Accepted r.pre r.ev = true ∧
  WFClass r.pre

/-- Chaining: the first record starts at `s` and each post-state is
the next pre-state.  Only the post-state equation is required here,
so that the replay theorem holds under the weakest hypothesis. -/
def Aligned : PState → List TRecord → Prop
  | _, [] => True
  | s, r :: rest => r.pre = s ∧ r.post = step r.pre r.ev ∧ Aligned r.post rest

def endState : PState → List TRecord → PState
  | s, [] => s
  | _, r :: rest => endState r.post rest

def eraseTrace (tr : List TRecord) : List PEvent := tr.map (fun r => r.ev)

def LegalTrace (s : PState) (tr : List TRecord) : Prop :=
  Aligned s tr ∧ ∀ r ∈ tr, WFRecord r

theorem replayP_cons (a : PEvent) (l : List PEvent) (s : PState) :
    replayP (a :: l) s = replayP l (step s a) := rfl

/-- **Erasure commutes with replay.**  A chained typed trace erases to
an event list that replays to the trace's own end state: the typed
layer adds no information replay does not already fix, and loses
none. -/
theorem replay_erases (tr : List TRecord) (s : PState) (h : Aligned s tr) :
    replayP (eraseTrace tr) s = endState s tr := by
  induction tr generalizing s with
  | nil => rfl
  | cons r rest ih =>
      obtain ⟨h1, h2, h3⟩ := h
      show replayP (r.ev :: eraseTrace rest) s = endState r.post rest
      rw [replayP_cons, ← h1, ← h2]
      exact ih r.post h3

theorem legal_trace_replays (tr : List TRecord) (s : PState)
    (h : LegalTrace s tr) :
    replayP (eraseTrace tr) s = endState s tr :=
  replay_erases tr s h.1

/-! ## 4. Commutation

Disjoint written support is NOT sufficient for commutation: a guard
reads fields its own step never writes. Three sufficient frame families
are declared field by field. In each family:

* `guardHolds` is insensitive to the written field, and
* the two post-state constructors commute as record updates.

Both halves are `rfl` for the declared insensitive events. Selected
excluded cases have Lean countermodels; the Python mirror audits every
excluded event only over its declared finite battery. Necessity and
exhaustiveness are not proved. -/

def licenseInsensitive : PEvent → Bool
  | .addCol _ => false
  | .setLicense _ => false
  | .halt => false
  | _ => true

def budgetInsensitive : PEvent → Bool
  | .refineCol _ _ => false
  | .addCol _ => false
  | .setBudget _ => false
  | .halt => false
  | _ => true

def occInsensitive : PEvent → Bool
  | .protect _ _ => true
  | .declareObs => true
  | .refuse _ _ => true
  | .setBudget _ => true
  | .setLicense _ => true
  | _ => false

theorem ne_halt_of_licenseInsensitive (e : PEvent)
    (h : licenseInsensitive e = true) : e ≠ .halt := by
  intro hc; subst hc; exact absurd h hfalse

theorem ne_halt_of_budgetInsensitive (e : PEvent)
    (h : budgetInsensitive e = true) : e ≠ .halt := by
  intro hc; subst hc; exact absurd h hfalse

theorem ne_halt_of_occInsensitive (e : PEvent)
    (h : occInsensitive e = true) : e ≠ .halt := by
  intro hc; subst hc; exact absurd h hfalse

theorem postOf_halted (s : PState) (e : PEvent) (h : e ≠ .halt) :
    (postOf s e).halted = s.halted := by
  cases e <;>
    first
      | exact absurd rfl h
      | rfl
      | (cases ho : s.obs <;> simp only [postOf, ho] <;> rfl)

theorem halted_frame (s : PState) (e : PEvent) (h : e ≠ .halt) :
    (step s e).halted = s.halted := by
  rw [step_eq_ite]
  split
  · exact postOf_halted s e h
  · rfl

theorem postOf_occ (s : PState) (e : PEvent) (h : occInsensitive e = true) :
    (postOf s e).occ = s.occ := by
  cases e <;>
    first
      | exact absurd h hfalse
      | rfl

theorem occ_unchanged (s : PState) (e : PEvent)
    (h : occInsensitive e = true) : (step s e).occ = s.occ := by
  rw [step_eq_ite]
  split
  · exact postOf_occ s e h
  · rfl

/-! ### The license frame -/

theorem guardHolds_licS (s : PState) (b : Bool) (e : PEvent)
    (h : licenseInsensitive e = true) :
    guardHolds (licS s b) e = guardHolds s e := by
  cases e <;>
    first
      | exact absurd h hfalse
      | rfl

theorem postOf_licS (s : PState) (b : Bool) (e : PEvent)
    (h : licenseInsensitive e = true) :
    postOf (licS s b) e = licS (postOf s e) b := by
  cases e <;>
    first
      | exact absurd h hfalse
      | rfl
      | (cases ho : s.obs <;> simp only [postOf, licS, ho, refineS])

theorem frame_licS (s : PState) (b : Bool) (e : PEvent)
    (h : licenseInsensitive e = true) :
    step (licS s b) e = licS (step s e) b := by
  rw [step_eq_ite (licS s b) e, step_eq_ite s e, guardHolds_licS s b e h,
    postOf_licS s b e h, apply_ite (fun x => licS x b)]

/-- **License writes commute with every license-insensitive event.** -/
theorem comm_setLicense (s : PState) (b : Bool) (e : PEvent)
    (h : licenseInsensitive e = true) :
    step (step s (.setLicense b)) e = step (step s e) (.setLicense b) := by
  have hne : e ≠ .halt := ne_halt_of_licenseInsensitive e h
  cases hh : s.halted with
  | true =>
      rw [step_halted s (.setLicense b) hh, step_halted s e hh,
        step_halted s (.setLicense b) hh]
  | false =>
      rw [step_setLicense_live s b hh, frame_licS s b e h,
        step_setLicense_live (step s e) b (by rw [halted_frame s e hne, hh])]

/-! ### The budget frame -/

theorem guardHolds_budS (s : PState) (n : Nat) (e : PEvent)
    (h : budgetInsensitive e = true) :
    guardHolds (budS s n) e = guardHolds s e := by
  cases e <;>
    first
      | exact absurd h hfalse
      | rfl

theorem postOf_budS (s : PState) (n : Nat) (e : PEvent)
    (h : budgetInsensitive e = true) :
    postOf (budS s n) e = budS (postOf s e) n := by
  cases e <;>
    first
      | exact absurd h hfalse
      | rfl

theorem frame_budS (s : PState) (n : Nat) (e : PEvent)
    (h : budgetInsensitive e = true) :
    step (budS s n) e = budS (step s e) n := by
  rw [step_eq_ite (budS s n) e, step_eq_ite s e, guardHolds_budS s n e h,
    postOf_budS s n e h, apply_ite (fun x => budS x n)]

/-- **Budget writes commute with every budget-insensitive event.** -/
theorem comm_setBudget (s : PState) (n : Nat) (e : PEvent)
    (h : budgetInsensitive e = true) :
    step (step s (.setBudget n)) e = step (step s e) (.setBudget n) := by
  have hne : e ≠ .halt := ne_halt_of_budgetInsensitive e h
  cases hh : s.halted with
  | true =>
      rw [step_halted s (.setBudget n) hh, step_halted s e hh,
        step_halted s (.setBudget n) hh]
  | false =>
      rw [step_setBudget_live s n hh, frame_budS s n e h,
        step_setBudget_live (step s e) n (by rw [halted_frame s e hne, hh])]

/-- The two environment writes commute with each other. -/
theorem comm_setBudget_setLicense (s : PState) (n : Nat) (b : Bool) :
    step (step s (.setBudget n)) (.setLicense b)
      = step (step s (.setLicense b)) (.setBudget n) :=
  comm_setBudget s n (.setLicense b) rfl

/-! ### The occurrence-supply frame -/

theorem guardHolds_occS (s : PState) (t : Nat) (e : PEvent)
    (h : occInsensitive e = true) :
    guardHolds (occS s t) e = guardHolds s e := by
  cases e <;>
    first
      | exact absurd h hfalse
      | rfl

theorem postOf_occS (s : PState) (t : Nat) (e : PEvent)
    (h : occInsensitive e = true) :
    postOf (occS s t) e = occS (postOf s e) t := by
  cases e <;>
    first
      | exact absurd h hfalse
      | rfl

theorem frame_occS (s : PState) (t : Nat) (e : PEvent)
    (h : occInsensitive e = true) :
    step (occS s t) e = occS (step s e) t := by
  rw [step_eq_ite (occS s t) e, step_eq_ite s e, guardHolds_occS s t e h,
    postOf_occS s t e h, apply_ite (fun x => occS x t)]

/-- **Occurrence supply commutes with every occurrence-insensitive
event** — including the case where the supply is itself inert. -/
theorem comm_admitOcc (s : PState) (t : Nat) (e : PEvent)
    (h : occInsensitive e = true) :
    step (step s (.admitOcc t)) e = step (step s e) (.admitOcc t) := by
  have hne : e ≠ .halt := ne_halt_of_occInsensitive e h
  have hh2 : (step s e).halted = s.halted := halted_frame s e hne
  cases hh : s.halted with
  | true =>
      rw [step_halted s (.admitOcc t) hh, step_halted s e hh,
        step_halted s (.admitOcc t) hh]
  | false =>
      by_cases hm : t ∈ s.occ
      · rw [step_admitOcc_inert s t hh hm,
          step_admitOcc_inert (step s e) t (by rw [hh2, hh])
            (by rw [occ_unchanged s e h]; exact hm)]
      · rw [step_admitOcc_acc s t hh hm, frame_occS s t e h,
          step_admitOcc_acc (step s e) t (by rw [hh2, hh])
            (by rw [occ_unchanged s e h]; exact hm)]

/-! ### The exact non-commutation countermodels -/

def wOneOcc : PState :=
  { occ := [5], asserted := [(0, 1)], wit := [], prot := [], obs := none,
    budget := 0, licensed := true, refusals := [], halted := false }

/-- The license is read by the extension guard: writing it does not
commute with extension. -/
theorem noncomm_license_extension :
    step (step wFunded (.setLicense false)) (.addCol [0])
      ≠ step (step wFunded (.addCol [0])) (.setLicense false) := by decide

/-- The budget is read by the extension guard as well. -/
theorem noncomm_budget_extension :
    step (step wFunded (.setBudget 0)) (.addCol [0])
      ≠ step (step wFunded (.addCol [0])) (.setBudget 0) := by decide

/-- The terminal commutes with nothing that is accepted: absorption
is not a frame. -/
theorem noncomm_terminal :
    step (step genesisP .halt) (.setLicense false)
      ≠ step (step genesisP (.setLicense false)) .halt := by decide

/-- Occurrence supply is read by the retention guard (well-formed
pairs must be represented), so supply does not commute with
retention. -/
theorem noncomm_supply_retention :
    step (step wOneOcc (.admitOcc 6)) (.admitWit 0 1)
      ≠ step (step wOneOcc (.admitWit 0 1)) (.admitOcc 6) := by decide

/-- **Two writes into the same list store do not commute** — the
store is a list, so presentation order is retained. -/
theorem noncomm_same_store :
    step (step wAssert (.assertWit 0 1)) (.assertWit 1 0)
      ≠ step (step wAssert (.assertWit 1 0)) (.assertWit 0 1) := by decide

/-- …and this is exactly a difference of PRESENTATION, not of
membership: the two results carry the same asserted pairs.  The two
notions are kept apart; the absence of an order test is never
converted into equality of states. -/
theorem same_store_observationally_equal :
    ((step (step wAssert (.assertWit 0 1)) (.assertWit 1 0)).asserted.all
      (fun p => decide (p ∈
        (step (step wAssert (.assertWit 1 0)) (.assertWit 0 1)).asserted))
      = true) ∧
    ((step (step wAssert (.assertWit 1 0)) (.assertWit 0 1)).asserted.all
      (fun p => decide (p ∈
        (step (step wAssert (.assertWit 0 1)) (.assertWit 1 0)).asserted))
      = true) := by decide

/-! ## 5. What an internal trace cannot do -/

theorem internal_trace_preserves_occ (l : List PEvent) (s : PState)
    (h : ∀ e ∈ l, isEnvOwned e = false) : (replayP l s).occ = s.occ := by
  induction l generalizing s with
  | nil => rfl
  | cons e rest ih =>
      show (replayP rest (step s e)).occ = s.occ
      rw [ih (step s e) (fun x hx => h x (List.mem_cons_of_mem e hx))]
      exact (nonEnv_preserves_occ_licensed s e (h e List.mem_cons_self)).1

theorem internal_trace_preserves_license (l : List PEvent) (s : PState)
    (h : ∀ e ∈ l, isEnvOwned e = false) :
    (replayP l s).licensed = s.licensed := by
  induction l generalizing s with
  | nil => rfl
  | cons e rest ih =>
      show (replayP rest (step s e)).licensed = s.licensed
      rw [ih (step s e) (fun x hx => h x (List.mem_cons_of_mem e hx))]
      exact (nonEnv_preserves_occ_licensed s e (h e List.mem_cons_self)).2

/-- The generator's blocks are internal in exactly this sense for
occurrence supply and the license — and NOT for the budget, which it
writes itself (`internal_family_emits_budget_write`). -/
theorem internal_blocks_cannot_supply_or_license (s : PState)
    (b : List PEvent) (hb : b ∈ nextFamilyP s) :
    (∀ e ∈ b, e ≠ PEvent.admitOcc 0) ∧
    (∀ e ∈ b, e ≠ PEvent.setLicense false) := by
  constructor
  · intro e he hc
    subst hc
    exact internal_family_no_occurrence_supply s b hb 0 he
  · intro e he hc
    subst hc
    exact internal_family_no_license_write s b hb false he

/-! ## 6. A refusal record is not erasable syntax -/

theorem refusal_persists_step (s : PState) (e : PEvent) (i j : Nat)
    (h : (i, j) ∈ s.refusals) : (i, j) ∈ (step s e).refusals := by
  cases e <;> simp only [step] <;> repeat' split
  all_goals
    first
      | exact h
      | (simp only [List.mem_append]; exact Or.inl h)

theorem refusal_persists_replay (l : List PEvent) (s : PState) (i j : Nat)
    (h : (i, j) ∈ s.refusals) : (i, j) ∈ (replayP l s).refusals := by
  induction l generalizing s with
  | nil => exact h
  | cons e rest ih =>
      show (i, j) ∈ (replayP rest (step s e)).refusals
      exact ih (step s e) (refusal_persists_step s e i j h)

/-- Refusal changes the state, and once recorded it survives every
event and every trace: it is not inert syntax that a rewrite may
delete. -/
theorem refusal_not_erasable :
    (Accepted wObstructed (.refuse 0 1) = true) ∧
    ((step wObstructed (.refuse 0 1)).refusals = [(0, 1)]) := by decide

/-! ## 7. Replay equivalence is scoped -/

def ReplayEqvOn (C : PState → Prop) (l₁ l₂ : List PEvent) : Prop :=
  ∀ s, C s → replayP l₁ s = replayP l₂ s

/-- The declared scope of the example: states that already represent
the occurrence. -/
def RepresentsZero (s : PState) : Prop := 0 ∈ s.occ

theorem replay_eqv_scoped :
    ReplayEqvOn RepresentsZero [PEvent.admitOcc 0] [] := by
  intro s hc
  show step s (.admitOcc 0) = s
  cases hh : s.halted with
  | true => exact step_halted s _ hh
  | false => exact step_admitOcc_inert s 0 hh hc

/-- …and the same pair is NOT equivalent unscoped: at genesis the
supply is accepted.  Replay equivalence without a declared start
class is not a relation this dynamics satisfies. -/
theorem replay_eqv_not_unscoped :
    replayP [PEvent.admitOcc 0] genesisP ≠ replayP [] genesisP := by decide

/-! ## 8. The rewrite system

Two rules, on event lists alone.  They are sound for EVERY start
state, which is strictly stronger than soundness relative to one
state. The present two-rule system is not complete even for the
state-independent fragment: `rewrite_not_complete` exhibits two lists
that replay identically from EVERY state and are not identified here.
This does not rule out a richer universal canonicalizer, and it does
not address a quotient scoped to one fixed start state. -/

inductive Rw : List PEvent → List PEvent → Prop where
  | idem (e : PEvent) (l : List PEvent) : Rw (e :: e :: l) (e :: l)
  | absorb (r : PEvent) (l : List PEvent) : Rw (.halt :: r :: l) [.halt]
  | cons (e : PEvent) {l l' : List PEvent} : Rw l l' → Rw (e :: l) (e :: l')

inductive RwStar : List PEvent → List PEvent → Prop where
  | refl (l : List PEvent) : RwStar l l
  | tail {a b c : List PEvent} : RwStar a b → Rw b c → RwStar a c

/-- **Soundness, at every start state.** -/
theorem rw_sound (l l' : List PEvent) (h : Rw l l') (s : PState) :
    replayP l s = replayP l' s := by
  induction h generalizing s with
  | idem e rest =>
      show replayP rest (step (step s e) e) = replayP rest (step s e)
      rw [step_idem]
  | absorb r rest =>
      show replayP (r :: rest) (step s .halt) = replayP [] (step s .halt)
      rw [replayP_halted (r :: rest) (step s .halt) rfl]
      rfl
  | cons e _ ih =>
      show replayP _ (step s e) = replayP _ (step s e)
      exact ih (step s e)

theorem rwStar_sound (l l' : List PEvent) (h : RwStar l l') (s : PState) :
    replayP l s = replayP l' s := by
  induction h with
  | refl => rfl
  | tail _ hr ih => rw [ih, rw_sound _ _ hr]

/-- **Termination**: every rule strictly shortens the list. -/
theorem rw_length (l l' : List PEvent) (h : Rw l l') :
    l'.length < l.length := by
  induction h with
  | idem e rest => simp only [List.length_cons]; omega
  | absorb r rest =>
      simp only [List.length_cons, List.length_nil]; omega
  | cons e _ ih => simp only [List.length_cons]; omega

/-! ### The computed normal form -/

def consNF (e : PEvent) : List PEvent → List PEvent
  | [] => [e]
  | f :: t => if e = f then f :: t else e :: f :: t

def nf : List PEvent → List PEvent
  | [] => []
  | e :: rest => if e = PEvent.halt then [PEvent.halt] else consNF e (nf rest)

def noRedex : List PEvent → Bool
  | [] => true
  | a :: rest =>
      match rest with
      | [] => true
      | b :: _ =>
          (!(decide (a = b))) && (!(decide (a = PEvent.halt)))
            && noRedex rest

theorem nf_halt (l : List PEvent) : nf (PEvent.halt :: l) = [PEvent.halt] := by
  show (if PEvent.halt = PEvent.halt then [PEvent.halt]
    else consNF PEvent.halt (nf l)) = [PEvent.halt]
  rw [if_pos rfl]

theorem nf_cons_ne (e : PEvent) (l : List PEvent) (h : e ≠ PEvent.halt) :
    nf (e :: l) = consNF e (nf l) := by
  show (if e = PEvent.halt then [PEvent.halt] else consNF e (nf l))
    = consNF e (nf l)
  rw [if_neg h]

theorem consNF_idem (e : PEvent) (r : List PEvent) :
    consNF e (consNF e r) = consNF e r := by
  cases r with
  | nil =>
      show (if e = e then [e] else e :: [e]) = [e]
      rw [if_pos rfl]
  | cons f t =>
      by_cases hc : e = f
      · have h1 : consNF e (f :: t) = f :: t := by
          show (if e = f then f :: t else e :: f :: t) = f :: t
          rw [if_pos hc]
        rw [h1, h1]
      · have h1 : consNF e (f :: t) = e :: f :: t := by
          show (if e = f then f :: t else e :: f :: t) = e :: f :: t
          rw [if_neg hc]
        rw [h1]
        show (if e = e then e :: f :: t else e :: e :: f :: t) = e :: f :: t
        rw [if_pos rfl]

theorem nf_idem_cons (e : PEvent) (l : List PEvent) :
    nf (e :: e :: l) = nf (e :: l) := by
  by_cases h : e = PEvent.halt
  · subst h; rw [nf_halt, nf_halt]
  · rw [nf_cons_ne e (e :: l) h, nf_cons_ne e l h, consNF_idem]

theorem nf_cons_congr (e : PEvent) (l l' : List PEvent) (h : nf l = nf l') :
    nf (e :: l) = nf (e :: l') := by
  by_cases hh : e = PEvent.halt
  · subst hh; rw [nf_halt, nf_halt]
  · rw [nf_cons_ne e l hh, nf_cons_ne e l' hh, h]

theorem rw_preserves_nf (l l' : List PEvent) (h : Rw l l') : nf l = nf l' := by
  induction h with
  | idem e rest => exact nf_idem_cons e rest
  | absorb r rest => rw [nf_halt, nf_halt]
  | cons e _ ih => exact nf_cons_congr e _ _ ih

theorem rwStar_preserves_nf (l l' : List PEvent) (h : RwStar l l') :
    nf l = nf l' := by
  induction h with
  | refl => rfl
  | tail _ hr ih => rw [ih, rw_preserves_nf _ _ hr]

theorem noRedex_consNF (e : PEvent) (r : List PEvent) (he : e ≠ PEvent.halt)
    (h : noRedex r = true) : noRedex (consNF e r) = true := by
  cases r with
  | nil => rfl
  | cons f t =>
      by_cases hc : e = f
      · have h1 : consNF e (f :: t) = f :: t := by
          show (if e = f then f :: t else e :: f :: t) = f :: t
          rw [if_pos hc]
        rw [h1]
        exact h
      · have h1 : consNF e (f :: t) = e :: f :: t := by
          show (if e = f then f :: t else e :: f :: t) = e :: f :: t
          rw [if_neg hc]
        rw [h1]
        show ((!(decide (e = f))) && (!(decide (e = PEvent.halt)))
          && noRedex (f :: t)) = true
        rw [decide_eq_false hc, decide_eq_false he, h]
        rfl

theorem nf_noRedex (l : List PEvent) : noRedex (nf l) = true := by
  induction l with
  | nil => rfl
  | cons e rest ih =>
      by_cases h : e = PEvent.halt
      · subst h; rw [nf_halt]; rfl
      · rw [nf_cons_ne e rest h]
        exact noRedex_consNF e (nf rest) h ih

theorem noRedex_nf_eq (l : List PEvent) (h : noRedex l = true) : nf l = l := by
  induction l with
  | nil => rfl
  | cons a rest ih =>
      cases rest with
      | nil =>
          by_cases hh : a = PEvent.halt
          · subst hh; rw [nf_halt]
          · rw [nf_cons_ne a [] hh]; rfl
      | cons b t =>
          have h' : ((!(decide (a = b))) && (!(decide (a = PEvent.halt)))
            && noRedex (b :: t)) = true := h
          simp only [Bool.and_eq_true, Bool.not_eq_true',
            decide_eq_false_iff_not] at h'
          obtain ⟨⟨hab, hah⟩, hrest⟩ := h'
          rw [nf_cons_ne a (b :: t) hah, ih hrest]
          show (if a = b then b :: t else a :: b :: t) = a :: b :: t
          rw [if_neg hab]

theorem rwStar_cons (e : PEvent) (l l' : List PEvent) (h : RwStar l l') :
    RwStar (e :: l) (e :: l') := by
  induction h with
  | refl => exact RwStar.refl _
  | tail _ hr ih => exact RwStar.tail ih (Rw.cons e hr)

theorem rwStar_to_nf (l : List PEvent) : RwStar l (nf l) := by
  induction l with
  | nil => exact RwStar.refl []
  | cons e rest ih =>
      by_cases h : e = PEvent.halt
      · subst h
        cases rest with
        | nil => rw [nf_halt]; exact RwStar.refl _
        | cons r t =>
            rw [nf_halt]
            exact RwStar.tail (RwStar.refl _) (Rw.absorb r t)
      · rw [nf_cons_ne e rest h]
        have h1 : RwStar (e :: rest) (e :: nf rest) :=
          rwStar_cons e rest (nf rest) ih
        cases hnf : nf rest with
        | nil =>
            rw [hnf] at h1
            exact h1
        | cons f t =>
            rw [hnf] at h1
            by_cases hef : e = f
            · have hc : consNF e (f :: t) = f :: t := by
                show (if e = f then f :: t else e :: f :: t) = f :: t
                rw [if_pos hef]
              rw [hc]
              subst hef
              exact RwStar.tail h1 (Rw.idem e t)
            · have hc : consNF e (f :: t) = e :: f :: t := by
                show (if e = f then f :: t else e :: f :: t) = e :: f :: t
                rw [if_neg hef]
              rw [hc]
              exact h1

/-- **Confluence** on the whole fragment: any two reducts join, at the
computed normal form of the common source. -/
theorem rw_confluent (l a b : List PEvent) (ha : RwStar l a)
    (hb : RwStar l b) : ∃ c, RwStar a c ∧ RwStar b c := by
  refine ⟨nf l, ?_, ?_⟩
  · rw [rwStar_preserves_nf l a ha]
    exact rwStar_to_nf a
  · rw [rwStar_preserves_nf l b hb]
    exact rwStar_to_nf b

/-- **Unique normal forms.** -/
theorem nf_unique (l a b : List PEvent) (ha : RwStar l a) (hb : RwStar l b)
    (hna : noRedex a = true) (hnb : noRedex b = true) : a = b := by
  have h1 : nf a = nf l := (rwStar_preserves_nf l a ha).symm
  have h2 : nf b = nf l := (rwStar_preserves_nf l b hb).symm
  rw [noRedex_nf_eq a hna] at h1
  rw [noRedex_nf_eq b hnb] at h2
  rw [h1, ← h2]

theorem nf_sound (l : List PEvent) (s : PState) :
    replayP (nf l) s = replayP l s :=
  (rwStar_sound l (nf l) (rwStar_to_nf l) s).symm

/-- **The system is deliberately incomplete.** Two budget writes in a
row replay identically to the second one alone at every state, but this
two-rule normalizer assigns different normal forms. Thus `nf` is not
complete for universal replay equivalence. This witness does not rule
out some richer complete canonicalizer, nor does it address a fixed
start-state quotient. -/
theorem rewrite_not_complete :
    (∀ s : PState, replayP [PEvent.setBudget 1, PEvent.setBudget 2] s
      = replayP [PEvent.setBudget 2] s) ∧
    nf [PEvent.setBudget 1, PEvent.setBudget 2] ≠ nf [PEvent.setBudget 2] := by
  constructor
  · intro s
    show step (step s (.setBudget 1)) (.setBudget 2) = step s (.setBudget 2)
    cases hh : s.halted with
    | true => rw [step_halted s (.setBudget 1) hh]
    | false =>
        rw [step_setBudget_live s 1 hh,
          step_setBudget_live (budS s 1) 2
            (show (budS s 1).halted = false from hh),
          step_setBudget_live s 2 hh]
        rfl
  · decide

end TraceAlgebra
