# Optional live proposer demo (code/live_proposer_demo.py) for PFP Paper 002.
# The live demo is not part of the paper's evidence and needs your own
# OpenRouter key (https://openrouter.ai/keys). This template holds a
# placeholder only; never commit or share a file containing a real key.
#
# Either export OPENROUTER_API_KEY in your shell, or copy this file to a
# private file such as .env (excluded from the deposit and from git), replace
# the placeholder, and name the file explicitly:
#   py -3.12 code/run_demos.py --live --env-file .env
# No directory is searched for credentials.
OPENROUTER_API_KEY=your_openrouter_api_key_here
