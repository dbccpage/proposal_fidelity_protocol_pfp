    },
    {
      "id": "RLA-F09",
      "statement": "The Hermitian-order sample checker validates sign range on supplied samples but accepts any nonnegative sign on a computed norm. A valid Gaussian arithmetic/involution with fixed_field_sign(17)=Some(2) passes samples0,1,-1,4+i even though the checker itself queries the invalid sign on norm(4+i)=17.",
      "evidence": [
        {
          "path": "code/rust/core_linear_algebra/src/exact_field/laws.rs",
