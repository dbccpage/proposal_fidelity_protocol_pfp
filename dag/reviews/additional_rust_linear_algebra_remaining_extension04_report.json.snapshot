  "findings": [
    {
      "id": "RLA-F01",
      "statement": "RankNullity admission accepts a reduced matrix and kernel from different matrices, and a declared column count different from the reduced width. Its count certificate cannot certify that the supplied vectors form the kernel of the supplied matrix.",
      "evidence": [
