    },
    {
      "id": "RFA-F010",
      "severity": "medium",
      "title": "Power-basis helper allocates before checked shape admission",
      "statement": "invert_by_multiplication_matrix computes vec![zero;dim*dim] using unchecked usize multiplication before invoking BasicMatrix::from_row_major. At64bit dim=2^32, mathematical square is2^64: debug arithmetic panics, release multiplication wraps0 and subsequent nonempty column writes can index out of bounds. Return Option does not cover this input failure.",
      "evidence": [
