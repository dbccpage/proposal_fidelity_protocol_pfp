          "sha256": "7936943fe821f8bcdc51971597f00d627d1467e1a7c9ac48c69beebe542fa98c",
          "lines": [
            236,
            276
          ]
        },
        {
          "path": "code/rust/core_adversary/src/stage/ddc_tape_evaluator.rs",
          "sha256": "7936943fe821f8bcdc51971597f00d627d1467e1a7c9ac48c69beebe542fa98c",
          "lines": [
            785,
            813
          ]
        }
      ],
      "independent_controls": [
        "RA-T03"
      ],
      "limits": "Exact contradiction in the inspected rules; no Rust execution. Legacy M T semantics differ and are not covered by this counterexample.",
      "next_action": "Choose one explicit OEARS completion rule for refusal and align complete validation, terminalized state, replay and tests with it."
    },
    {
      "id": "RAD-F04",
      "title": "Exact per-step metrics do not guarantee exact bounded window arithmetic.",
      "assessment": "Metrics are reduced to Rational64 individually, then sliding-window sum/mean uses unchecked Rational64 additions. Two individually representable i64-max integer metrics already require an unrepresentable sum. Missing metrics also enter history as zero, which conflates unavailable and measured zero for these summaries.",
      "priority": "P1",
      "source_evidence": [
        {
          "path": "code/rust/core_adversary/src/stage/ddc_tape_evaluator.rs",
          "sha256": "7936943fe821f8bcdc51971597f00d627d1467e1a7c9ac48c69beebe542fa98c",
