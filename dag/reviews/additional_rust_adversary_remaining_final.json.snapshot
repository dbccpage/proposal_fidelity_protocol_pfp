  "findings": [
    {
      "id": "RAD-F01",
      "title": "DDC step-chain hashes omit metrics and timestamps.",
      "assessment": "The step hash input contains class/carrier/witness/receipt labels but excludes phi_1, gamma_2 and timestamp. Two admitted steps with identical included fields and different metrics therefore have the same prehash input and head while producing different metric histories. State hashes also hash class labels rather than state bytes.",
      "priority": "P1",
      "source_evidence": [
        {
          "path": "code/rust/core_adversary/src/stage/ddc_tape_evaluator.rs",
          "sha256": "7936943fe821f8bcdc51971597f00d627d1467e1a7c9ac48c69beebe542fa98c",
          "lines": [
            519,
            595
          ]
        },
        {
          "path": "code/rust/core_adversary/src/stage/ddc.rs",
          "sha256": "440e92ba890570109f761a0c372c826ac7ac25ef85f536ca85e61cda5f5067cf",
          "lines": [
            1,
            52
          ]
        }
      ],
      "independent_controls": [
        "RA-T01"
      ],
      "limits": "An omitted-field projection, not a SHA collision or a demonstrated historical tampering event. A separate immutable full receipt may supply the missing binding, but this head alone does not.",
      "next_action": "Before using the tape head to bind evaluator results, hash the complete canonical step including metrics and time/policy semantics or explicitly bind a separately checked full-step digest."
    },
    {
      "id": "RAD-F02",
      "title": "Compensation heads bind branch ID and count rather than branch contents.",
      "assessment": "record_compensation_branch checks authority and nonempty class labels, but the hash record includes only branch_id and step_count alongside chain metadata. Different branch tapes of the same length can share a head in separate histories; branch DFA validity is not checked here.",
      "priority": "P1",
      "source_evidence": [
        {
          "path": "code/rust/core_adversary/src/stage/ddc_tape_evaluator.rs",
          "sha256": "7936943fe821f8bcdc51971597f00d627d1467e1a7c9ac48c69beebe542fa98c",
          "lines": [
            717,
            779
          ]
        }
      ],
      "independent_controls": [
        "RA-T02"
      ],
      "limits": "Duplicate IDs within one evaluator are refused. The finite counterexample concerns two histories and does not claim a hash collision.",
      "next_action": "Bind the complete ordered compensation steps and run the intended dialect/adjacency checks before treating a compensation head as evidence of the branch."
    },
    {
      "id": "RAD-F03",
      "title": "OEARS terminal refusal conflicts with complete-tape admission.",
      "assessment": "The OEARS M rule permits no following token, while complete validation requires the final token T for every dialect. M is a valid refusal prefix, M is incomplete, and M T is rejected. Thus no completed OEARS tape can contain that terminal refusal.",
      "priority": "P1",
      "source_evidence": [
        {
          "path": "code/rust/core_adversary/src/stage/ddc_tape_evaluator.rs",
          "sha256": "7936943fe821f8bcdc51971597f00d627d1467e1a7c9ac48c69beebe542fa98c",
          "lines": [
            133,
            166
          ]
        },
        {
