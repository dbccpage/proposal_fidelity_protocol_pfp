    {
      "path": "ops/governance/domain/swarm_control/n1_lease.py",
      "sha256": "7c9daee8700244fbce53277152edba609e273bae5085d4d44fe485b97b4e8523",
      "bytes": 3100,
      "source_line_count": 87,
      "full_source_read": true,
      "reviewed_lines": [
        [
          1,
          87
        ]
      ],
      "review_level": "full_raw_source_body_review",
      "assessment": "N1Lease canonicalizes identifier roles and path/resource collections, but direct non-int epoch/fence inputs bypass value-object conversion. It does not check nonempty scope, issue-before-expiry, exact boolean killed flag or expiry. ID-based equality does not compare scope/time/owner. It is a lease record, not proof of current authority.",
      "actual_execution_status": "Source review only; no original module, provider, network or native execution. Independent controls, if added, are recorded separately.",
      "source_evidence": [
        {
          "path": "ops/governance/domain/swarm_control/n1_lease.py",
          "sha256": "7c9daee8700244fbce53277152edba609e273bae5085d4d44fe485b97b4e8523",
          "lines": [
            1,
            87
          ],
          "range_kind": "full body read"
        }
      ]
    },
    {
      "path": "ops/governance/domain/swarm_control/n1_lease_registry.py",
      "sha256": "6d9457960a3f610e696a3996bb0bdcf68127460ef700122bacc0e4ea6d53d0c1",
      "bytes": 4813,
      "source_line_count": 119,
      "full_source_read": true,
      "reviewed_lines": [
        [
          1,
          119
        ]
      ],
      "review_level": "full_raw_source_body_review",
      "assessment": "Registry grants increasing fences and rejects same-worktree path/resource overlap; revocations are sticky by supplied string key, and epoch changes invalidate old leases. Verification checks owner/epoch and only rejects lower fences, then trusts the supplied lease expiry: same-ID copies with larger fence, expanded scope or extended expiry are not compared to the stored grant. Keys are stored before Identifier normalization, and resources are checked only within equal worktree labels. Durable in-memory wording overstates persistence and no atomic concurrency mechanism exists.",
      "actual_execution_status": "Source review only; no original module, provider, network or native execution. Independent controls, if added, are recorded separately.",
      "source_evidence": [
        {
          "path": "ops/governance/domain/swarm_control/n1_lease_registry.py",
