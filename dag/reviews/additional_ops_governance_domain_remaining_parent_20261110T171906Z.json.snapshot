    {
      "path": "ops/governance/domain/swarm_control/git_hygiene_policy.py",
      "sha256": "e6b6561a9ef0eabd93d3a3b586e17735d6c8a2602bee3cb9fd7bc5aaf12af75b",
      "bytes": 3421,
      "source_line_count": 119,
      "full_source_read": true,
      "reviewed_lines": [
        [
          1,
          119
        ]
      ],
      "review_level": "full_raw_source_body_review",
      "assessment": "Git hygiene parses selected global options and refuses broad add without -- and explicit force worktree removal. Unknown/attached globals stop parsing and then default allow, while add -- . or broad magic pathspecs pass because post-delimiter paths are not narrowed. Shell strings use POSIX shlex with a fallback split, so this is not a universal shell command policy. It should be treated as a bounded argv lint rule, not complete command authorization.",
      "actual_execution_status": "Source review only; no original module, provider, network or native execution. Independent controls, if added, are recorded separately.",
      "source_evidence": [
