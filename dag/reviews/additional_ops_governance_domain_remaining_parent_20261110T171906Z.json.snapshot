      "sha256": "6937fdac1dfa1c0ad8c621942aeec04e72c57b44b040652eb80749c695fc6a67",
      "bytes": 2543,
      "source_line_count": 70,
      "full_source_read": true,
      "reviewed_lines": [
        [
          1,
          70
        ]
      ],
      "review_level": "full_raw_source_body_review",
      "assessment": "Manifest rejects empty/duplicate exact paths and computes a path-sorted NUL-delimited SHA256. Tuple storage preserves input order, so permutation-equivalent mutation collections share digest but need not compare equal. Canonical serialization assumes fields cannot contain NUL; current path/unused-field admission does not enforce that assumption, enabling an exact same-byte encoding of distinct records without a cryptographic collision. No blob content or actual Git tree is verified here.",
      "actual_execution_status": "Source review only; no original module, provider, network or native execution. Independent controls, if added, are recorded separately.",
