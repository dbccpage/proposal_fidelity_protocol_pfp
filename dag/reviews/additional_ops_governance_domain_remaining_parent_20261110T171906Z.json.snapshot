      "full_source_read": true,
      "reviewed_lines": [
        [
          1,
          53
        ]
      ],
      "review_level": "full_raw_source_body_review",
      "assessment": "Mode coercion rejects unknown strings and non-string/non-enum inputs. STRICT requires every supplied status to equal MEASURED and rejects OPTIONAL_SKIP; DEV rejects only NOT_MEASURED and otherwise accepts arbitrary status labels. An empty required mapping passes vacuously, so completeness of the required obligation set must be checked by a caller. These are finite label predicates, not measurement provenance.",
