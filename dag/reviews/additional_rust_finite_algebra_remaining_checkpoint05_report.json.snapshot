          "sha256": "886f8903ab2a97cc8a3f630168473e69512827ed86304f2f571c3906ea10b3a1",
          "lines": [
            29,
            129
          ]
        }
      ],
      "limits": "Prime-factorization and sum-of-two-squares theorem dependencies; independent small controls do not certify unrestricted factorization or total bounded search. F009 records raw representation false-negative."
    },
    {
      "id": "RFA-CL006",
      "statement": "Rational circle and finite dyadic modules preserve explicit carrier, conductor, finite-prefix and budget boundaries. Circle Haar routines execute finite character sums and return conditional finite Lipschitz enclosures; they do not infer an infinite sampling family or topology.",
      "evidence": [
        {
          "path": "code/rust/core_number_theory/src/rational_circle.rs",
          "sha256": "c9ad54faef3007a103422060e30153c06955013c4802e7fcf68a05bb5c4e9787",
          "lines": [
            13,
            51
          ]
