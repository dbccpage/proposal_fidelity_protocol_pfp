    {
      "id": "RFA-CL007",
      "statement": "Certified-angle routines construct rational endpoint enclosures with explicit input and series limits; square roots replay endpoint squares, while atan/pi use alternating-series and rational argument identities with allocated width budgets.",
      "evidence": [
        {
          "path": "code/rust/core_number_theory/src/certified_angles.rs",
