  "findings": [
    {
      "id": "ROUT-F001",
      "severity": "high",
      "title": "GateReceipt unit test has ownership and trait requirements unsatisfied by its types",
      "finding": "lib.rs:287 maps a receipt to(receipt.fuel_after(),receipt.licensed()); both accessors consume self and GateReceipt is not Copy. The second access uses a moved value. assert_eq! on Result additionally requires GateError PartialEq and Debug, neither derived nor implemented in the scoped source. This is a source-established test-compilation obstruction, not an observed compiler run.",
      "evidence": [
        {
          "path": "code/rust/core_ooutwire_primitives/src/lib.rs",
          "sha256": "a9f3ceb42008f2601b5ca6f4597f9ec9deb040e6d8b1f30cd04e5eecedfd8618",
          "lines": [
            242,
            277
