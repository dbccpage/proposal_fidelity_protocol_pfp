            ],
            "target_zero_based_slice": [
              783,
              784
            ],
            "before": "At that audited commit, no detector is therefore admitted and active through\r\nthis record. Later integration requires its own source audit and execution. It shows that\r\n",
            "after": "No detector is therefore admitted and active through this record. It shows that\r\n"
