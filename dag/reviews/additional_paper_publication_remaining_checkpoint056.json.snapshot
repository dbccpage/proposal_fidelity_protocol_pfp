            ],
            "target_zero_based_slice": [
              193,
              195
            ],
            "before": "\\texttt{\\nolinkurl{52cb5457f6c485ba548cfd292f6012a941ed22cf}}. The\r\nmain sources are\r\n",
            "after": "\\nolinkurl{52cb5457f6c485ba548cfd292f6012a941ed22cf}. The main sources\r\nare\r\n"
          },
          {
            "operation": "replace",
            "base_lines": [
              215,
              219
            ],
            "target_zero_based_slice": [
              202,
              203
            ],
            "before": "chain with a header, not a general graph of arbitrary dependencies. A\r\nchain is a special kind of directed acyclic graph when edges are\r\noriented from each new entry to its earlier predecessor; that structural\r\nobservation supplies neither arbitrary dependency edges nor a semantic\r\nmining algorithm.\r\n",
            "after": "chain with a header, not a general graph of arbitrary dependencies.\r\n"
