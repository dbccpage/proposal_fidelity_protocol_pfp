// No `abstract_category` feature exists, and `braided_monoidal` above requires
// this module unconditionally — the old cfg(not(feature)) gate was dead.
pub mod monoidal_category {
    use super::core::Category;

    pub trait MonoidalCategory: Category {
        type TensorProduct<A, B>: Clone;

        fn unit() -> Self::Ob;
    }
}

