    }

    pub mod natural_trans {
        pub use super::super::natural_trans::*;
    }

    pub mod profunctor {
        // pub use super::super::profunctor::*;
    }

    pub mod monoidal_category {
        // pub use super::super::monoidal_category::*;
    }

    pub mod braided_monoidal {
        pub use super::super::braided_monoidal::*;
    }
}

