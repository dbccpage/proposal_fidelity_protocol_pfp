//! Arithmos category substrate.
//!
//! The finite/auditable layer is the canonical implementation target. The
//! `core`, `functor`, and `braided_monoidal` modules below are compatibility
//! contracts for older abstract arithmos files that still use the pre-migration
//! trait names.

pub mod core {
    pub trait Category {
        type Ob: Clone + PartialEq + Eq + std::fmt::Debug;
        type Mor: Clone + PartialEq + Eq + std::fmt::Debug;

        fn identity<A>(object: &A) -> Self::Mor;
        fn compose<A, B, C>(first: &Self::Mor, second: &Self::Mor) -> Option<Self::Mor>;
    }

    pub trait MorphismEq: Category {
        fn morphism_eq<A, B>(left: &Self::Mor, right: &Self::Mor) -> bool {
            left == right
        }
    }
}

pub mod functor {
    pub use super::cat_functor::DeclaredFiniteFunctor;

    pub trait Functor<C, D>
    where
        C: super::core::Category,
        D: super::core::Category,
    {
        type Obj<A>;

        fn fmap<A, B>(f: impl Fn(A) -> B) -> impl Fn(Self::Obj<A>) -> Self::Obj<B>;
    }
}

pub mod braided_monoidal {
    pub trait BraidedMonoidalCategory: super::monoidal_category::MonoidalCategory {
        fn braiding<A, B>() -> Self::Mor
        where
            Self: super::core::Category;
    }
}

pub mod errors {
    #[derive(Debug, Clone, PartialEq, Eq)]
    pub enum ArithmosError {
        LawViolation(String),
        PreconditionFailed(String),
        InvalidShape(String),
    }
}

pub mod witness {
    #[derive(Debug, Clone, PartialEq, Eq)]
    pub struct Witness {
        pub name: String,
    }

    impl Witness {
        pub fn new(name: impl Into<String>) -> Self {
            Self { name: name.into() }
        }
    }
}

pub mod law {
    use super::errors::ArithmosError;
    use super::witness::Witness;

    pub trait Law {
        type Subject;

        fn check(subject: &Self::Subject) -> Result<Witness, ArithmosError>;
    }
}

pub mod functors {
    pub use super::*;

    pub mod functor {
        pub use super::super::cat_functor::*;
    }
}

pub mod category {
    pub mod core {
        pub use super::super::core::*;
    }

    pub mod functor {
