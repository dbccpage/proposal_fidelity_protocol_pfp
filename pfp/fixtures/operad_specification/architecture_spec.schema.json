{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_length": {
          "maximum": 1048576,
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "byte_length",
        "media_type"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BoundObligation": {
      "additionalProperties": false,
      "properties": {
        "obligation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Obligation Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Kind",
          "type": "string"
        },
        "subject_artifact_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Subject Artifact Ids",
          "type": "array"
        },
        "evidence_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Evidence Artifact Id",
          "type": "string"
        },
        "verification_status": {
          "const": "declared_unverified",
          "default": "declared_unverified",
          "title": "Verification Status",
          "type": "string"
        }
      },
      "required": [
        "obligation_id",
        "kind",
        "subject_artifact_ids",
        "evidence_artifact_id"
      ],
      "title": "BoundObligation",
      "type": "object"
    },
    "CongruenceIdeal": {
      "additionalProperties": false,
      "properties": {
        "ideal_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Ideal Id",
          "type": "string"
        },
        "relation_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Relation Artifact Id",
          "type": "string"
        },
        "substitution_closure": {
          "$ref": "#/$defs/BoundObligation"
        },
        "action": {
          "enum": [
            "quotient_declaration",
            "typed_null_tree"
          ],
          "title": "Action",
          "type": "string"
        },
        "enforcement_status": {
          "const": "not_executed",
          "default": "not_executed",
          "title": "Enforcement Status",
          "type": "string"
        }
      },
      "required": [
        "ideal_id",
        "relation_artifact_id",
        "substitution_closure",
        "action"
      ],
      "title": "CongruenceIdeal",
      "type": "object"
    },
    "DPODeclaration": {
      "additionalProperties": false,
      "properties": {
        "declaration_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Declaration Id",
          "type": "string"
        },
        "owner": {
          "const": "pfp.domain.rewriting.finite_dpo.apply_registered_rule",
          "default": "pfp.domain.rewriting.finite_dpo.apply_registered_rule",
          "title": "Owner",
          "type": "string"
        },
        "owner_source_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Owner Source Artifact Id",
          "type": "string"
        },
        "supported_schema": {
          "const": "finite-attributed-directed-graph-identity-key-monic-v1",
          "title": "Supported Schema",
          "type": "string"
        },
        "rule_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Rule Artifact Id",
          "type": "string"
        },
        "schema_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Schema Artifact Id",
          "type": "string"
        },
        "left_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Left Artifact Id",
          "type": "string"
        },
        "interface_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Interface Artifact Id",
          "type": "string"
        },
        "right_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Right Artifact Id",
          "type": "string"
        },
        "host_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Host Artifact Id",
          "type": "string"
        },
        "match_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Match Artifact Id",
          "type": "string"
        },
        "obligations": {
          "items": {
            "$ref": "#/$defs/BoundObligation"
          },
          "maxItems": 32,
          "minItems": 10,
          "title": "Obligations",
          "type": "array"
        },
        "verification_status": {
          "const": "declaration_only_no_rewrite_or_confluence_verified",
          "default": "declaration_only_no_rewrite_or_confluence_verified",
          "title": "Verification Status",
          "type": "string"
        }
      },
      "required": [
        "declaration_id",
        "owner_source_artifact_id",
        "supported_schema",
        "rule_artifact_id",
        "schema_artifact_id",
        "left_artifact_id",
        "interface_artifact_id",
        "right_artifact_id",
        "host_artifact_id",
        "match_artifact_id",
        "obligations"
      ],
      "title": "DPODeclaration",
      "type": "object"
    },
    "DensityDeclaration": {
      "additionalProperties": false,
      "properties": {
        "density_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Density Id",
          "type": "string"
        },
        "fiber_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Fiber Id",
          "type": "string"
        },
        "dimension": {
          "maximum": 1048576,
          "minimum": 1,
          "title": "Dimension",
          "type": "integer"
        },
        "coefficient_domain": {
          "const": "Q(i)",
          "default": "Q(i)",
          "title": "Coefficient Domain",
          "type": "string"
        },
        "matrix_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Matrix Artifact Id",
          "type": "string"
        },
        "owner": {
          "const": "core_quantum_physics::density_matrix::ExactDensityMatrix",
          "default": "core_quantum_physics::density_matrix::ExactDensityMatrix",
          "title": "Owner",
          "type": "string"
        },
        "owner_source_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Owner Source Artifact Id",
          "type": "string"
        },
        "obligations": {
          "items": {
            "$ref": "#/$defs/BoundObligation"
          },
          "maxItems": 16,
          "minItems": 3,
          "title": "Obligations",
          "type": "array"
        },
        "verification_status": {
          "const": "matrix_not_loaded_hermiticity_trace_psd_not_verified",
          "default": "matrix_not_loaded_hermiticity_trace_psd_not_verified",
          "title": "Verification Status",
          "type": "string"
        }
      },
      "required": [
        "density_id",
        "fiber_id",
        "dimension",
        "matrix_artifact_id",
        "owner_source_artifact_id",
        "obligations"
      ],
      "title": "DensityDeclaration",
      "type": "object"
    },
    "EpistemicBundleDeclaration": {
      "additionalProperties": false,
      "description": "Finite vector-bundle/sheaf metadata; no gluing or cocycle solver runs.",
      "properties": {
        "bundle_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Bundle Id",
          "type": "string"
        },
        "base_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Base Artifact Id",
          "type": "string"
        },
        "cover_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Cover Artifact Id",
          "type": "string"
        },
        "transition_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Transition Artifact Id",
          "type": "string"
        },
        "sheaf_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Sheaf Artifact Id",
          "type": "string"
        },
        "fiber_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Fiber Ids",
          "type": "array"
        },
        "rank": {
          "maximum": 1048576,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "cocycle_obligations": {
          "items": {
            "$ref": "#/$defs/BoundObligation"
          },
          "maxItems": 32,
          "minItems": 3,
          "title": "Cocycle Obligations",
          "type": "array"
        },
        "verification_status": {
          "const": "declared_unverified_no_bundle_sheaf_or_gluing_theorem",
          "default": "declared_unverified_no_bundle_sheaf_or_gluing_theorem",
          "title": "Verification Status",
          "type": "string"
        }
      },
      "required": [
        "bundle_id",
        "base_artifact_id",
        "cover_artifact_id",
        "transition_artifact_id",
        "sheaf_artifact_id",
        "fiber_ids",
        "rank",
        "cocycle_obligations"
      ],
      "title": "EpistemicBundleDeclaration",
      "type": "object"
    },
    "FiniteFiber": {
      "additionalProperties": false,
      "properties": {
        "fiber_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Fiber Id",
          "type": "string"
        },
        "base_observation_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Base Observation Artifact Id",
          "type": "string"
        },
        "dimension": {
          "maximum": 1048576,
          "minimum": 1,
          "title": "Dimension",
          "type": "integer"
        },
        "tensor_factors": {
          "items": {
            "$ref": "#/$defs/TensorFactor"
          },
          "maxItems": 16,
          "title": "Tensor Factors",
          "type": "array"
        },
        "interpretation_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Interpretation Artifact Id",
          "type": "string"
        },
        "semantic_status": {
          "const": "finite_model_declaration_only",
          "default": "finite_model_declaration_only",
          "title": "Semantic Status",
          "type": "string"
        }
      },
      "required": [
        "fiber_id",
        "base_observation_artifact_id",
        "dimension",
        "tensor_factors",
        "interpretation_artifact_id"
      ],
      "title": "FiniteFiber",
      "type": "object"
    },
    "GraftNode": {
      "additionalProperties": false,
      "description": "input_permutation[slot] indexes children for that operator input slot.",
      "properties": {
        "kind": {
          "const": "graft",
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "operator_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Operator Id",
          "type": "string"
        },
        "children": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Children",
          "type": "array"
        },
        "input_permutation": {
          "items": {
            "maximum": 1048576,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 32,
          "title": "Input Permutation",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "node_id",
        "operator_id",
        "children",
        "input_permutation"
      ],
      "title": "GraftNode",
      "type": "object"
    },
    "GraftTree": {
      "additionalProperties": false,
      "properties": {
        "tree_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Tree Id",
          "type": "string"
        },
        "nodes": {
          "items": {
            "discriminator": {
              "mapping": {
                "graft": "#/$defs/GraftNode",
                "leaf": "#/$defs/LeafNode",
                "null_tree": "#/$defs/NullTreeNode"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LeafNode"
              },
              {
                "$ref": "#/$defs/GraftNode"
              },
              {
                "$ref": "#/$defs/NullTreeNode"
              }
            ]
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "root": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Root",
          "type": "string"
        },
        "expected_output_colour": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Expected Output Colour",
          "type": "string"
        }
      },
      "required": [
        "tree_id",
        "nodes",
        "root",
        "expected_output_colour"
      ],
      "title": "GraftTree",
      "type": "object"
    },
    "LeafNode": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "leaf",
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "span_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Span Id",
          "type": "string"
        },
        "colour": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Colour",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node_id",
        "span_id",
        "colour"
      ],
      "title": "LeafNode",
      "type": "object"
    },
    "NominalColour": {
      "additionalProperties": false,
      "properties": {
        "colour_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Colour Id",
          "type": "string"
        },
