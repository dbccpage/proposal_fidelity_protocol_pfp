        },
        "interpretation_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Interpretation Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "colour_id",
        "payload_schema_artifact_id",
        "interpretation_artifact_id"
      ],
      "title": "NominalColour",
      "type": "object"
    },
    "NullTreeNode": {
      "additionalProperties": false,
      "description": "A typed failed term; it is never a zero matrix or a density operator.",
      "properties": {
        "kind": {
          "const": "null_tree",
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "colour": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Colour",
          "type": "string"
        },
        "refusal_code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Refusal Code",
          "type": "string"
        },
        "evidence_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Evidence Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node_id",
        "colour",
        "refusal_code",
        "evidence_artifact_id"
      ],
      "title": "NullTreeNode",
      "type": "object"
    },
    "OperatorSignature": {
      "additionalProperties": false,
      "properties": {
        "operator_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
