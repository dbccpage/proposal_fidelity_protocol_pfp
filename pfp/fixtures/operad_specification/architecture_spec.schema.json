            "signing",
            "external_write"
          ],
          "title": "Effect Class",
          "type": "string"
        },
        "work_limit": {
          "maximum": 1048576,
          "minimum": 1,
          "title": "Work Limit",
          "type": "integer"
        },
        "semantics_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "title": "Semantics Artifact Id",
          "type": "string"
        },
        "ideal_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Ideal Ids",
          "type": "array"
        },
        "equivariance": {
          "$ref": "#/$defs/BoundObligation"
        }
      },
      "required": [
        "operator_id",
        "input_colours",
        "output_colour",
        "polarity",
        "effect_class",
        "work_limit",
        "semantics_artifact_id",
        "equivariance"
