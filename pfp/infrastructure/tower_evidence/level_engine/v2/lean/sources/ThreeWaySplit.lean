  ((List.range s.points).all fun v => decide (sumTo s.sides (fun e => entry s.d0 e v * pick s.h e) = 0)) &&
  ((List.range s.cells).all fun c => decide (sumTo s.sides (fun e => entry s.d1 c e * pick s.h e) = 0))

/-- `d0 p + h + d1^T q = c`. -/
