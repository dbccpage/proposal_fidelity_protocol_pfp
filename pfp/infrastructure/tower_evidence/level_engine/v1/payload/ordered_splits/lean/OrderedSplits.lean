/-- An exact pair `a + b i`. -/
abbrev Pair := Prod QN QN

def padd (x y : Pair) : Pair := (x.1 + y.1, x.2 + y.2)

def pmul (x y : Pair) : Pair := (x.1 * y.1 - x.2 * y.2, x.1 * y.2 + x.2 * y.1)

/-- The mirror of a pair: `a - b i`. -/
def mirror (x : Pair) : Pair := (x.1, -x.2)

/-- The size of a pair: `a * a + b * b`. -/
