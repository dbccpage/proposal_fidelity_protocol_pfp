namespace CycleWords

open ExactRat

/-- A word of length two, as the positions of its two letters. -/
abbrev Word := Prod Nat Nat

/-- Turning a word once exchanges its letters. -/
def turn (w : Word) : Word := (w.2, w.1)

/-- The turns of a word. -/
def turns (w : Word) : List Word := if w.1 = w.2 then [w] else [w, turn w]

/-- A ring: its words, its lead and its declared span, when given. -/
structure Ring where
  words : List Word
  lead : Option Word
  span : Option Nat

def sameSet (a b : List Word) : Bool := a.all (fun x => b.contains x) && b.all (fun x => a.contains x)

/-- Each ring holds exactly the turns of its lead. -/
def oneClass (rs : List Ring) : Bool :=
  rs.all fun r => match r.lead with
    | some l => sameSet r.words (turns l)
    | none => false

/-- The least number of turns that returns a word of length two. -/
def leastSpan (w : Word) : Nat := if w.1 = w.2 then 1 else 2

/-- Each ring's declared span is the least span of its lead. -/
def spanLeast (rs : List Ring) : Bool :=
  rs.all fun r => match r.lead, r.span with
    | some l, some s => s == leastSpan l
    | _, _ => false

def lexLe (a b : Word) : Bool := a.1 < b.1 || (a.1 == b.1 && a.2 <= b.2)

/-- Each ring's lead is the least of its turns. -/
def leadLeast (rs : List Ring) : Bool :=
  rs.all fun r => match r.lead with
    | some l => lexLe l (turn l)
    | none => false

def rings_pos : List Ring :=
  [{ words := [(0, 0)], lead := some (0, 0), span := some 1 },
   { words := [(0, 1), (1, 0)], lead := some (0, 1), span := some 2 },
   { words := [(1, 1)], lead := some (1, 1), span := some 1 }]

def rings_own_neg : List Ring :=
  [{ words := [(0, 0)], lead := some (0, 0), span := some 2 },
   { words := [(0, 1), (1, 0)], lead := some (0, 1), span := some 2 },
   { words := [(1, 1)], lead := some (1, 1), span := some 1 }]

def rings_near_span : List Ring :=
  [{ words := [(0, 0)], lead := some (0, 0), span := some 1 },
   { words := [(0, 1), (1, 0)], lead := some (0, 1), span := some 1 },
   { words := [(1, 1)], lead := some (1, 1), span := some 1 }]

def rings_near_lead : List Ring :=
  [{ words := [(0, 0)], lead := some (0, 0), span := some 1 },
   { words := [(0, 1), (1, 0)], lead := some (1, 0), span := some 2 },
   { words := [(1, 1)], lead := some (1, 1), span := some 1 }]

def rings_near_stray : List Ring :=
  [{ words := [(0, 0), (1, 1)], lead := some (0, 0), span := some 1 },
   { words := [(0, 1), (1, 0)], lead := some (0, 1), span := some 2 }]

theorem pos_one_class : oneClass rings_pos = true := by decide

theorem pos_span_least : spanLeast rings_pos = true := by decide

theorem pos_lead_least : leadLeast rings_pos = true := by decide

theorem own_neg_one_class : oneClass rings_own_neg = true := by decide

theorem own_neg_span_least : spanLeast rings_own_neg = false := by decide

theorem own_neg_lead_least : leadLeast rings_own_neg = true := by decide

theorem near_span_one_class : oneClass rings_near_span = true := by decide

theorem near_span_span_least : spanLeast rings_near_span = false := by decide

theorem near_span_lead_least : leadLeast rings_near_span = true := by decide

theorem near_lead_one_class : oneClass rings_near_lead = true := by decide

theorem near_lead_span_least : spanLeast rings_near_lead = true := by decide

