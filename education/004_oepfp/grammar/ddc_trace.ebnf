(* ddc-tape-shape-v1: structural language of Quiz 09's list checker.
   AuthorityEffect: None. Encodes C first, T last, M immediately before T.
   Repeated C is admitted by that checker. Full DDC step preconditions,
   state stationarity, descent and lift authorization are separate checks. *)
ddc_trace = "tape<c,", { ordinary_event, "," }, [ "m," ], "t>" ;
ordinary_event = "c" | "r" | "e" | "i" | "lift" | "d" ;
