operads/** text eol=lf
eis/antibodies/** text eol=lf
# Lesson sources the typed contracts pin by SHA-256.
_ic/** text eol=lf

# workflows/ (formerly demos/) challenge packages pin case files and manifests by the SHA-256 of their LF bytes.
workflows/** text eol=lf

# Images stay binary even under code/, which is pinned to LF text above.
*.gif binary

