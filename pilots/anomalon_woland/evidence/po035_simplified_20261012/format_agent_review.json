  "finding": {
    "severity": "P2",
    "title": "Descriptive layout wrappers are copied as response keys",
    "observed_evidence": "All six scoped complete JSON replies emit root_required_only; three of four final replies also emit row_required_only. None reached its completion cap; all finish_reason values are stop. Strict ingress correctly refuses all six at additionalProperties.",
    "mechanism_inference": "The participant contract presents root_required_only and row_required_only as response-shaped dictionaries and describes actual sections nesting in a string. This is consistent with the observed literal wrapper copying, but these observations do not isolate a causal ingredient.",
    "additional_format_failures": "Every final summary is a string rather than its required three-field object. Pilot200 uses strings or type/carrier descriptions where native certificate arrays are required. Some calculations add an extra certificate level. Unwrapping would not recover the intended schema.",
    "preflight_limit": "Renderer/schema consistency and valid host fixtures passed offline; that did not establish that this cheap hosted model would instantiate the verbal layout correctly."
  },
  "future_candidate": {
    "status": "UNTESTED_NOT_ADMITTED",
    "versioning": "Create new immutable role/recipe/registry versions and a new construction implementation; retain current frozen bytes and all refused replies. A presentation-only correction preserving the strict output contract can use PATCH versions under the registry policy.",
    "minimal_change": "Replace the response-shaped output_layout metadata with the minified actual role-specific JSON schema already used by the host, plus one short placement instruction. Do not send root_required_only, row_required_only, or certificate_fields as response-looking objects. Keep mathematical seeds, scope, hints, carrier tags, original CHECKS, caps and stage order fixed.",
    "placement_instruction": "Return an instance of response_schema, never the schema or its explanatory labels. Finals have only derived_under_policy, summary, process_integrity and sections at the root; summary and process_integrity are objects; the single proposal row goes only at sections[0].rows[0]. Workpads have only derived_under_policy, prompt_id, records and open at the root. Certificate arrays and booleans are native JSON values, not strings or type/carrier objects.",
    "no_answer_leakage": "The schema conveys types, shapes, identities and carrier constants only. Add no solved pilot values, expected witnesses or host verdicts.",
    "host_only_preflights": [
      "Assert the rendered wire contains the exact schema hash/version and complete nested placement contract.",
      "Assert explanatory wrapper names are absent from the intended response contract and forbidden by strict additionalProperties.",
      "Use separately identified host fixtures to validate nested summary/process_integrity, row placement and native array types; never inject these fixtures into participant requests.",
      "Add negative controls for wrapper copying, flattened summary/process fields, calculations.certificate nesting, stringified arrays and type/carrier certificate metadata.",
      "Recompute actual wire reservations and compare the intended contract bundle under unchanged caps before any authorized future call."
    ],
