{
  "type": "object",
  "properties": {
    "outcome": {"type": "string", "enum": ["QUERY_USER_MORE_INFO", "PROPOSAL"]},
    "seed": {"type": "string", "minLength": 1},
    "missing_fields": {"type": "array", "items": {"type": "string", "enum": ["object_model", "coefficient_domain", "requested_invariant"]}},
    "questions": {"type": "array", "items": {
      "type": "object",
      "properties": {
        "field": {"type": "string", "enum": ["object_model", "coefficient_domain", "requested_invariant"]},
        "question": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "required": ["field", "question"],
      "additionalProperties": false
    }},
    "proposal": {"type": "string", "maxLength": 1000}
  },
  "required": ["outcome", "seed", "missing_fields", "questions", "proposal"],
  "additionalProperties": false
}
